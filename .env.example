# 复制本文件为根目录 .env（已被 .gitignore 忽略，不会提交），按需填写。
# 所有键都可省略，省略时使用下面的默认值（server/env.mjs 里定义）。

# ============================ 运行时 ============================
# 监听端口与地址
PORT=4321
HOST=0.0.0.0
# production 会开启自动迁移、HTTPS 相关行为的严格模式
NODE_ENV=production

# ============================ 数据存储 ============================
# 数据根目录（默认 <项目根>/data）；下面两项未设时按此目录推导
# BLOG_DATA_DIR=/var/lib/blog
# SQLite 数据库文件
# BLOG_DB_PATH=/var/lib/blog/blog.db
# 上传文件（替代 R2）的存放目录
# BLOG_BLOB_DIR=/var/lib/blog/blobs
# 静态产物目录（默认 <项目根>/dist/client）
# BLOG_CLIENT_DIR=/opt/blog/dist/client

# 启动时自动套用 db/migrations；production 默认 true，开发默认 false
# BLOG_AUTO_MIGRATE=true

# ============================ 站点信息 ============================
SITE_NAME=月下独酌
SITE_SLOGAN=长月夜下，对影成楼。
SITE_POEM=月下少辞令，醉后自逍遥。
# 必须与用户实际访问的地址一致，否则 RSS / sitemap / canonical 会写错
SITE_URL=https://blog.example.com
# 可选文案
# SITE_TAGLINE=
# FOOTER_LINE=
# SEARCH_PLACEHOLDER=
# HERO_NOTE=

# ============================ 认证与安全 ============================
# 会话签名密钥：务必改成长随机串（至少 32 字节），否则登录态可被伪造
BLOG_SESSION_SECRET=
# 首次初始化管理员用；初始化后后台改密码即可，此值可留空
BLOG_ADMIN_PASSWORD=
# 登录限流
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW=300

# ============================ 上传与媒体 ============================
# 文件对外访问前缀；用本地存储时保持 /api/files 即可
R2_PUBLIC_URL=/api/files

# ============================ 页面缓存 ============================
# 匿名公开页面的进程内 LRU 缓存；false 关闭
# EDGE_CACHE=true
# 缓存容量上限（字节），默认 64MB
# BLOG_CACHE_MAX_BYTES=67108864

# ============================ 定时发布 ============================
# 是否启用进程内定时器（替代 Cloudflare cron），默认启用
# BLOG_SCHEDULER=true
# 轮询间隔（毫秒），默认 5 分钟
# BLOG_SCHEDULER_INTERVAL_MS=300000
# 内部调度路由的共享密钥；留空时仅允许本机回环调用
# BLOG_SCHEDULER_TOKEN=

# ============================ 邮件 ============================
# 留空则不发送邮件（注册验证码改为直接返回，仅适合内网自用）
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# ============================ AI 摘要 ============================
# 用于加密存储后台配置的 API Key，需 32 字节 base64 或 hex
# AI_SETTINGS_ENCRYPTION_KEY=

# ============================ 主题与字体（构建期变量） ============================
# 构建时生效，不是运行时变量：pnpm build 前设置
# BLOG_THEME=modern
# 字体切片外链前缀；留空走本站 /api/files
# FONTS_BASE=