{
  "name": "blog",
  "type": "module",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "astro": "astro",
    "build": "node scripts/build.mjs",
    "build:admin": "pnpm -C admin run build",
    "cf:config": "node scripts/cf-config.mjs",
    "cf:db:local": "node scripts/cf-config.mjs && wrangler d1 execute blog-db --local --file=db/reset-local.sql && wrangler d1 migrations apply blog-db --local && wrangler d1 execute blog-db --local --file=db/seed.sql",
    "cf:deploy": "pnpm run build && wrangler deploy",
    "cf:dev": "pnpm run build && wrangler dev",
    "cf:import": "node server/cf-import.mjs",
    "cf:login": "wrangler login",
    "db:reset": "node server/migrate.mjs && node scripts/db-seed.mjs",
    "deploy": "node scripts/deploy.mjs",
    "dev": "astro dev",
    "dev:admin": "pnpm -C admin run dev",
    "fonts:sync": "node scripts/fonts-sync.mjs",
    "format": "prettier --write \"src/**/*.{ts,astro}\" \"tests/**/*.ts\" \"scripts/**/*.{mjs,ts}\" \"admin/src/**/*.{ts,vue}\"",
    "format:check": "prettier --check \"src/**/*.{ts,astro}\" \"tests/**/*.ts\" \"scripts/**/*.{mjs,ts}\" \"admin/src/**/*.{ts,vue}\"",
    "migrate": "node server/migrate.mjs --verbose",
    "preview": "astro preview",
    "setup": "node scripts/setup-deploy.mjs",
    "start": "node server/index.mjs",
    "start:prod": "NODE_ENV=production node server/index.mjs",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "theme": "node scripts/theme.mjs",
    "theme:add": "node scripts/theme-add.mjs",
    "theme:pack": "node scripts/theme-pack.mjs",
    "theme:update": "node scripts/theme-update.mjs",
    "typecheck": "pnpm run typecheck:astro && pnpm run typecheck:admin && pnpm run typecheck:worker && pnpm run typecheck:tests",
    "typecheck:admin": "pnpm -C admin run typecheck",
    "typecheck:astro": "astro check",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "typecheck:worker": "tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "astro": "^7.2.2",
    "d3": "^7.9.0",
    "diff": "^9.0.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.4",
    "marked": "^18.0.9",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.16.1",
    "nodemailer": "^9.0.5",
    "sanitize-html": "^2.17.0",
    "@astrojs/cloudflare": "14.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/diff": "^7.0.2",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "^5.7.0",
    "@cloudflare/workers-types": "^5.20260817.1",
    "wrangler": "^4.123.0",
    "miniflare": "5.20260811.1-alpha"
  }
}
