{
  "name": "blog",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/cf-config.mjs && pnpm -C admin run build && astro build && node scripts/merge-admin.mjs && node scripts/build-worker.mjs",
    "build:admin": "pnpm -C admin run build",
    "dev:admin": "pnpm -C admin run dev",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "pnpm run typecheck:astro && pnpm run typecheck:admin && pnpm run typecheck:worker && pnpm run typecheck:tests",
    "typecheck:astro": "astro check",
    "typecheck:admin": "pnpm -C admin run typecheck",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "cf:login": "wrangler login",
    "cf:config": "node scripts/cf-config.mjs",
    "cf:db:local": "node scripts/cf-config.mjs && wrangler d1 execute blog-db --local --file=db/reset.sql && wrangler d1 migrations apply blog-db --local && wrangler d1 execute blog-db --local --file=db/seed.sql",
    "cf:dev": "pnpm run build && wrangler dev",
    "cf:deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.1",
    "astro": "^7.2.2",
    "d3": "^7.9.0",
    "diff": "^9.0.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.4",
    "marked": "^18.0.9",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.16.1",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^5.20260815.1",
    "@types/diff": "^7.0.2",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.0.0",
    "@types/sanitize-html": "^2.16.0",
    "esbuild": "^0.28.2",
    "miniflare": "5.20260811.1-alpha",
    "typescript": "^5.7.0",
    "wrangler": "^4.60.0"
  }
}
