{
  "name": "blog",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "admin"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/cf-config.mjs && npm run build:admin && astro build && node scripts/merge-admin.mjs",
    "build:admin": "npm --prefix admin run build",
    "dev:admin": "npm --prefix admin run dev",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "npm run typecheck:astro && npm run typecheck:admin",
    "typecheck:astro": "astro check",
    "typecheck:admin": "npm --prefix admin run typecheck",
    "test": "node --test \"tests/**/*.test.ts\"",
    "cf:login": "wrangler login",
    "cf:config": "node scripts/cf-config.mjs",
    "cf:db:local": "node scripts/cf-config.mjs && wrangler d1 migrations apply blog-db --local && wrangler d1 execute blog-db --local --file=db/seed.sql",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.1",
    "astro": "^7.2.2",
    "diff": "^9.0.0",
    "marked": "^18.0.9",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^5.20260815.1",
    "@types/diff": "^7.0.2",
    "@types/node": "^24.0.0",
    "@types/sanitize-html": "^2.16.0",
    "miniflare": "5.20260811.1-alpha",
    "typescript": "^5.7.0",
    "wrangler": "^4.60.0"
  }
}
