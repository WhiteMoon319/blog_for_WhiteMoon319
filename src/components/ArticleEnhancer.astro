---
// 文章增强：KaTeX 公式样式（公式由服务端渲染，此处只引入样式）、代码高亮主题、
// mermaid 与 markmap 图表的运行时渲染。仅文章/预览等渲染正文的页面引入。
import 'katex/dist/katex.min.css';
import 'highlight.js/styles/github-dark.css';
---

<script>
  import mermaid from 'mermaid';
  import { Transformer } from 'markmap-lib';
  import { Markmap } from 'markmap-view';

  // 仅在存在图表容器时初始化，避免空页浪费
  const has = (cls: string) => document.querySelectorAll(`.diagram.${cls}`).length > 0;

  if (has('mermaid') || has('markmap')) {
    const init = async () => {
      // ---- mermaid ----
      if (has('mermaid')) {
        mermaid.initialize({ startOnLoad: false, theme: 'default', securityLevel: 'strict' });
        await Promise.all(
          Array.from(document.querySelectorAll<HTMLDivElement>('.diagram.mermaid')).map(async (el, i) => {
            try {
              const { svg } = await mermaid.render(`mermaid-${i}`, el.textContent ?? '');
              el.innerHTML = svg;
              el.classList.add('diagram-rendered');
            } catch {
              el.classList.add('diagram-error');
            }
          }),
        );
      }

      // ---- markmap ----
      if (has('markmap')) {
        const transformer = new Transformer();
        document.querySelectorAll<HTMLDivElement>('.diagram.markmap').forEach((el) => {
          try {
            const { root } = transformer.transform(el.textContent ?? '');
            const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
            svg.setAttribute('class', 'markmap-svg');
            el.appendChild(svg);
            const mm = Markmap.create(svg, { autoFit: true, initialExpandLevel: 2 }, root);
            el.classList.add('diagram-rendered');
            // 挂到元素上便于主题/缩放调整（如打印前展开）
            (el as HTMLDivElement & { _markmap?: typeof mm })._markmap = mm;
          } catch {
            el.classList.add('diagram-error');
          }
        });
      }
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => void init());
    } else {
      void init();
    }
  }
</script>