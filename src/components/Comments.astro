interface Props { postId: number }
const { postId } = Astro.props;
const r2Base = await import('../lib/db').then((m) => m.envOf()).then((env) => (env.R2_PUBLIC_URL || '').replace(/\/+$/, ''));
---

<section class="comments" data-post-id={postId} data-r2={r2Base} id="comments">
  <h2 class="comments-title">留言</h2>
  <div class="comments-status"></div>
  <div class="comments-auth"></div>
  <form class="comment-form" style="display:none;">
    <textarea class="comment-input" rows="3" maxlength="2000" placeholder="写下你的想法…"></textarea>
    <div class="comment-attachments"></div>
    <div class="comment-form-row">
      <label class="comment-img-btn">＋ 图片（≤3 张）<input type="file" accept="image/png,image/jpeg,image/webp,image/gif" multiple hidden /></label>
      <span class="comment-hint">不含敏感词将直接展示</span>
      <button type="submit" class="btn btn-primary mini">发表</button>
    </div>
  </form>
  <ol class="comments-list"></ol>
  <div class="comments-empty" style="display:none;">暂无留言。</div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('.comments')!;
  const postId = Number(root.dataset.postId);
  const r2Base = root.dataset.r2 ?? '';
  const statusEl = root.querySelector<HTMLElement>('.comments-status')!;
  const authEl = root.querySelector<HTMLElement>('.comments-auth')!;
  const formEl = root.querySelector<HTMLFormElement>('.comment-form')!;
  const listEl = root.querySelector<HTMLElement>('.comments-list')!;
  const emptyEl = root.querySelector<HTMLElement>('.comments-empty')!;
  const inputEl = root.querySelector<HTMLTextAreaElement>('.comment-input')!;
  const attachEl = root.querySelector<HTMLElement>('.comment-attachments')!;
  const fileInput = root.querySelector<HTMLInputElement>('input[type=file]')!;
  const images: string[] = [];
  let replyParentId: number | null = null;
  let me: { authenticated: boolean; email_verified?: boolean } | null = null;

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  function parseAttachments(raw: unknown): string[] {
    if (Array.isArray(raw)) return raw.filter((k): k is string => typeof k === 'string');
    if (typeof raw === 'string') try { const p = JSON.parse(raw); return Array.isArray(p) ? p.filter((k): k is string => typeof k === 'string') : []; } catch { return []; }
    return [];
  }

  async function loadMe() {
    const res = await fetch('/api/auth/me', { credentials: 'same-origin' });
    if (res.status === 401) return null;
    return res.json() as Promise<{ authenticated: boolean; email_verified?: boolean }>;
  }

  async function loadComments() {
    const res = await fetch(`/api/posts/${postId}/comments`);
    const data = await res.json() as { comments?: any[] };
    renderTree(data.comments ?? []);
  }

  function renderTree(comments: any[]) {
    listEl.innerHTML = '';
    if (!comments.length) { emptyEl.style.display = 'block'; return; }
    emptyEl.style.display = 'none';
    for (const c of comments) {
      const li = document.createElement('li');
      li.className = 'comment';
      li.innerHTML = commentHtml(c);
      listEl.appendChild(li);
      if (c.children?.length) {
        const wrap = document.createElement('div');
        wrap.className = 'comment-replies-wrap';
        const toggle = document.createElement('button');
        toggle.type = 'button';
        toggle.className = 'btn btn-ghost mini comment-toggle-replies';
        toggle.textContent = `回复 ${c.children.length} 条`;
        const ul = document.createElement('ul');
        ul.className = 'comment-replies';
        ul.hidden = true;
        for (const ch of c.children) { const l = document.createElement('li'); l.className = 'comment'; l.innerHTML = commentHtml(ch); ul.appendChild(l); }
        wrap.appendChild(toggle);
        wrap.appendChild(ul);
        toggle.addEventListener('click', () => {
          const open = ul.hidden;
          ul.hidden = !open;
          toggle.textContent = open ? '收起回复' : `回复 ${c.children.length} 条`;
        });
        li.appendChild(wrap);
      }
    }
  }

  function commentHtml(c: any): string {
    const attach = parseAttachments(c.attachments).map((k: string) => `<img src="${r2Base}/${esc(k)}" loading="lazy" class="comment-img" />`).join('');
    const replyBtn = c.parent_id === null ? `<button type="button" class="btn btn-ghost mini comment-reply" data-parent="${c.id}" data-name="${esc(c.display_name || c.username)}">回复</button>` : '';
    const floor = c.parent_id === null ? `#${c.floor}` : `#${c.floor}`;
    const likeBtn = `<button type="button" class="btn btn-ghost mini comment-like" data-id="${c.id}" data-liked="${c.liked_by_me ? '1' : '0'}">${c.liked_by_me ? '❤' : '♡'} <span class="comment-like-count">${c.likes_count ?? 0}</span></button>`;
    const avatar = c.avatar_url ? `<img src="${esc(c.avatar_url)}" class="comment-avatar" />` : `<span class="comment-avatar comment-avatar-placeholder">${(c.display_name || c.username || '?')[0].toUpperCase()}</span>`;
    return `
      <div class="comment-head">
        ${avatar}
        <div class="comment-head-text">
          <span class="comment-author">${esc(c.display_name || c.username || '匿名')}</span>
          <span class="comment-floor">${floor}</span>
          <span class="comment-time">${esc((c.created_at || '').slice(0, 16).replace('T', ' '))}</span>
        </div>
      </div>
      <div class="comment-body">${esc(c.body)}</div>
      ${attach ? `<div class="comment-attach">${attach}</div>` : ''}
      <div class="comment-actions">${replyBtn}${likeBtn}</div>`;
  }

  function renderAuth() {
    if (!me) { authEl.innerHTML = `<p class="comments-login"><a href="/login/?redirect=${encodeURIComponent(location.pathname)}">登录</a> 或 <a href="/register/">注册</a> 后可留言</p>`; return; }
    if (!me.email_verified) { authEl.innerHTML = `<p class="comments-login">请先<a href="/verify-email/">验证邮箱</a>后再留言</p>`; return; }
    formEl.style.display = 'block';
  }

  function renderStatus(msg: string, err = false) {
    statusEl.textContent = msg;
    statusEl.className = 'comments-status ' + (err ? 'err' : 'ok');
  }

  fileInput.addEventListener('change', async () => {
    for (const f of Array.from(fileInput.files ?? [])) {
      if (images.length >= 3) break;
      if (f.size > 2 * 1024 * 1024) { renderStatus('图片不能超过 2MB', true); continue; }
      const fd = new FormData(); fd.append('file', f);
      const res = await fetch('/api/comments/upload', { method: 'POST', credentials: 'same-origin', body: fd });
      const data = await res.json() as { error?: string; key?: string; url?: string };
      if (!res.ok) { renderStatus(data.error || '上传失败', true); continue; }
      images.push(data.key!);
      const img = document.createElement('img'); img.src = data.url!; img.className = 'comment-attach-thumb';
      attachEl.appendChild(img);
    }
  });

  formEl.addEventListener('submit', async (e) => {
    e.preventDefault();
    const body = inputEl.value.trim();
    if (!body) { renderStatus('请输入内容', true); return; }
    const res = await fetch('/api/comments', {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ post_id: postId, parent_id: replyParentId, body, attachments: images }),
    });
    const data = await res.json() as { error?: string };
    if (res.status === 403 && data.error === 'email_required') { location.href = '/verify-email/'; return; }
    if (!res.ok) { renderStatus(data.error || '发表失败', true); return; }
    inputEl.value = ''; images.length = 0; attachEl.innerHTML = ''; replyParentId = null;
    renderStatus('评论已提交，审核通过后可见');
    // 在列表末尾插入一条占位提示
    emptyEl.style.display = 'none';
    const pendingEl = document.createElement('div');
    pendingEl.className = 'comment-pending';
    pendingEl.textContent = '您的评论已提交，等待审核中…';
    listEl.appendChild(pendingEl);
  });

  listEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.comment-reply');
    if (btn) {
      replyParentId = Number(btn.dataset.parent) || null;
      inputEl.value = `@${btn.dataset.name} `; inputEl.focus();
      window.scrollTo({ top: formEl.offsetTop, behavior: 'smooth' });
      return;
    }
    const likeBtn = (e.target as HTMLElement).closest<HTMLButtonElement>('.comment-like');
    if (likeBtn) {
      void toggleLike(likeBtn);
    }
  });

  async function toggleLike(btn: HTMLButtonElement) {
    if (!me) { location.href = '/login/?redirect=' + encodeURIComponent(location.pathname); return; }
    if (!me.email_verified) { location.href = '/verify-email/'; return; }
    const id = Number(btn.dataset.id);
    if (!id) return;
    btn.disabled = true;
    try {
      const res = await fetch(`/api/comments/${id}/like`, { method: 'POST', credentials: 'same-origin' });
      const data = await res.json() as { liked?: boolean; likes_count?: number; error?: string };
      if (!res.ok) { renderStatus(data.error || '点赞失败', true); return; }
      btn.dataset.liked = data.liked ? '1' : '0';
      btn.innerHTML = `${data.liked ? '❤' : '♡'} <span class="comment-like-count">${data.likes_count ?? 0}</span>`;
    } finally {
      btn.disabled = false;
    }
  }

  loadMe().then((u) => { me = u; renderAuth(); });
  loadComments();
</script>

<style>
  .comments { max-width: 760px; margin: 3em auto 0; padding: 2em 24px 0; border-top: 1px solid var(--hairline); }
  .comments-title { font-family: var(--font-brush); font-size: 1.3rem; font-weight: 400; letter-spacing: 0.1em; margin: 0 0 1.2em; color: var(--ink-deep); }
  .comments-status { font-size: 0.82rem; margin-bottom: 0.8em; min-height: 1.2em; }
  .comments-status.err { color: var(--cinnabar); }
  .comments-status.ok { color: var(--ink-soft); }
  .comments-login { font-size: 0.9rem; color: var(--ink-mid); margin-bottom: 1.2em; }
  .comments-login a { color: var(--cinnabar); }
  .comment-form { margin-bottom: 2em; }
  .comment-input { width: 100%; min-height: 4.6em; padding: 0.8em 1em; border: 1px solid var(--hairline); border-radius: 8px; background: var(--paper-card); font: inherit; resize: vertical; box-sizing: border-box; transition: border-color 0.15s; }
  .comment-input:focus { border-color: var(--cinnabar); outline: none; }
  .comment-form-row { display: flex; align-items: center; gap: 14px; margin-top: 10px; flex-wrap: wrap; }
  .comment-img-btn { font-size: 0.8rem; color: var(--ink-soft); cursor: pointer; padding: 4px 0; }
  .comment-img-btn:hover { color: var(--ink-deep); }
  .comment-hint { font-size: 0.75rem; color: var(--ink-light); }
  .comment-attachments { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
  .comment-attach-thumb { width: 80px; height: 80px; object-fit: cover; border-radius: 8px; border: 1px solid var(--hairline); }
  .comments-list { list-style: none; margin: 0; padding: 0; }
  .comment { padding: 1em 0 1em 0; }
  .comment + .comment { border-top: 1px solid var(--hairline); }
  .comment-head { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
  .comment-avatar { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
  .comment-avatar-placeholder { width: 32px; height: 32px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: var(--cinnabar); color: #fff; font-size: 0.85rem; font-weight: 600; flex-shrink: 0; }
  .comment-head-text { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .comment-floor { color: var(--ink-light); font-size: 0.75rem; min-width: 2em; }
  .comment-author { font-size: 0.9rem; color: var(--ink-deep); font-weight: 600; }
  .comment-time { font-size: 0.72rem; color: var(--ink-light); }
  .comment-body { font-size: 0.95rem; line-height: 1.8; color: var(--ink-deep); white-space: pre-wrap; word-break: break-word; }
  .comment-attach { margin-top: 8px; }
  .comment-img { max-width: 100%; max-height: 400px; border-radius: 6px; margin-top: 4px; }
  .comment-actions { margin-top: 8px; display: flex; gap: 8px; }
  .comment-like { padding: 2px 8px; }
  .comment-like-count { margin-left: 2px; }
  .comment-replies-wrap { margin-top: 8px; }
  .comment-toggle-replies { margin-bottom: 4px; }
  .comment-replies { list-style: none; margin: 0.6em 0 0 0; padding: 0; border-left: 2px solid var(--hairline); padding-left: 1em; }
  .comment-replies > .comment { border: none; }
  .comments-empty { color: var(--ink-light); font-size: 0.85rem; padding: 1.2em 0; }
  .comment-pending { color: var(--cinnabar); font-size: 0.85rem; padding: 0.8em 0; border-bottom: 1px dashed var(--hairline); }
</style>