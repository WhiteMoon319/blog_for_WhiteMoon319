interface Props {
  postId: number;
}

const { postId } = Astro.props;
const r2Base = await import('../lib/db').then((m) => m.envOf()).then((env) => (env.R2_PUBLIC_URL || '').replace(/\/+$/, ''));
---

<section class="comments" data-post-id={postId} data-r2={r2Base} id="comments">
  <h2 class="comments-title">留言</h2>
  <div class="comments-status"></div>
  <div class="comments-auth"></div>
  <form class="comment-form" style="display:none;">
    <textarea class="comment-input" rows="3" maxlength="2000" placeholder="写下你的想法…"></textarea>
    <div class="comment-attachments"></div>
    <div class="comment-form-row">
      <label class="comment-img-btn">
        ＋ 图片（≤3 张）
        <input type="file" accept="image/png,image/jpeg,image/webp,image/gif" multiple hidden />
      </label>
      <span class="comment-hint">审核通过后显示</span>
      <button type="submit" class="btn btn-primary mini">发表</button>
    </div>
  </form>
  <ol class="comments-list"></ol>
  <div class="comments-empty" style="display:none;">暂无留言。</div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('.comments');
  if (!root) throw new Error('no comments root');
  const postId = Number(root.dataset.postId);
  const r2Base = root.dataset.r2 ?? '';
  const statusEl = root.querySelector<HTMLElement>('.comments-status')!;
  const authEl = root.querySelector<HTMLElement>('.comments-auth')!;
  const formEl = root.querySelector<HTMLFormElement>('.comment-form')!;
  const listEl = root.querySelector<HTMLElement>('.comments-list')!;
  const emptyEl = root.querySelector<HTMLElement>('.comments-empty')!;
  const inputEl = root.querySelector<HTMLTextAreaElement>('.comment-input')!;
  const attachEl = root.querySelector<HTMLElement>('.comment-attachments')!;
  const fileInput = root.querySelector<HTMLInputElement>('input[type=file]')!;
  const images: string[] = [];
  let me: { authenticated: boolean; email_verified?: boolean } | null = null;

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  async function fixCookies() {
    // 让公开页也能发送带 Cookie 的请求
  }

  async function loadMe() {
    const res = await fetch('/api/auth/me', { credentials: 'same-origin' });
    if (res.status === 401) return null;
    return res.json();
  }

  async function loadComments() {
    const res = await fetch(`/api/posts/${postId}/comments`);
    const data = await res.json();
    renderTree(data.comments ?? []);
  }

  function renderTree(comments: any[]) {
    listEl.innerHTML = '';
    if (!comments.length) {
      emptyEl.style.display = 'block';
      return;
    }
    emptyEl.style.display = 'none';
    for (const c of comments) {
      const li = renderComment(c);
      listEl.appendChild(li);
      if (c.children?.length) {
        const ul = document.createElement('ul');
        ul.className = 'comment-replies';
        for (const ch of c.children) ul.appendChild(renderComment(ch));
        li.appendChild(ul);
      }
    }
  }

  function renderComment(c: any): HTMLElement {
    const li = document.createElement('li');
    li.className = 'comment';
    li.dataset.id = c.id;
    const attach = Array.isArray(c.attachments) && c.attachments.length
      ? c.attachments.map((k: string) => `<img src="${r2Base}/${esc(k)}" loading="lazy" class="comment-img" />`).join('')
      : '';
    const replyBtn = c.parent_id === null ? `<button class="btn btn-ghost mini comment-reply" data-parent="${c.id}" data-name="${esc(c.display_name || c.username)}">回复</button>` : '';
    li.innerHTML = `
      <div class="comment-head">
        <span class="comment-floor">${c.floor}</span>
        <span class="comment-author">${esc(c.display_name || c.username)}</span>
        <span class="comment-time">${esc((c.created_at || '').slice(0, 16).replace('T', ' '))}</span>
      </div>
      <div class="comment-body">${esc(c.body)}</div>
      ${attach ? `<div class="comment-attach">${attach}</div>` : ''}
      <div class="comment-actions">${replyBtn}</div>`;
    return li;
  }

  function renderAuth() {
    if (!me) {
      authEl.innerHTML = `<p class="comments-login">登录后可评论 — <a href="/login/?redirect=${encodeURIComponent(location.pathname)}">登录</a> / <a href="/register/">注册</a></p>`;
      return;
    }
    if (!me.email_verified) {
      authEl.innerHTML = `<p class="comments-login">请先验证邮箱后再评论 — <a href="/verify-email/">去验证</a></p>`;
      return;
    }
    formEl.style.display = 'block';
  }

  function renderStatus(msg: string, err = false) {
    statusEl.textContent = msg;
    statusEl.className = 'comments-status ' + (err ? 'err' : 'ok');
  }

  fileInput.addEventListener('change', async () => {
    const files = Array.from(fileInput.files ?? []);
    for (const f of files) {
      if (images.length >= 3) break;
      if (f.size > 2 * 1024 * 1024) { renderStatus('图片不能超过 2MB', true); continue; }
      const fd = new FormData();
      fd.append('file', f);
      const res = await fetch('/api/comments/upload', { method: 'POST', credentials: 'same-origin', body: fd });
      const data = await res.json();
      if (!res.ok) { renderStatus(data.error || '上传失败', true); continue; }
      images.push(data.key);
      const img = document.createElement('img');
      img.src = data.url;
      img.className = 'comment-attach-thumb';
      attachEl.appendChild(img);
    }
  });

  formEl.addEventListener('submit', async (e) => {
    e.preventDefault();
    const body = inputEl.value.trim();
    if (!body) { renderStatus('请输入内容', true); return; }
    const res = await fetch('/api/comments', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ post_id: postId, body, attachments: images }),
    });
    const data = await res.json();
    if (res.status === 403 && data.error === 'email_required') {
      location.href = '/verify-email/';
      return;
    }
    if (!res.ok) {
      renderStatus(data.error || '发表失败（可能需要登录或验证邮箱）', true);
      return;
    }
    inputEl.value = '';
    images.length = 0;
    attachEl.innerHTML = '';
    renderStatus('待审核，通过后可见');
    await loadComments();
  });

  listEl.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.comment-reply');
    if (!btn) return;
    // 回填到表单，回复当前评论（作为 body 前缀，简化处理）
    inputEl.value = `@${btn.dataset.name} `;
    inputEl.focus();
  });

  loadMe().then((u) => { me = u; renderAuth(); });
  loadComments();
</script>

<style>
  .comments {
    margin: 3em 0 0;
    padding-top: 2em;
    border-top: 1px solid var(--hairline);
  }
  .comments-title {
    font-family: var(--font-brush);
    font-size: 1.2rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    margin: 0 0 1em;
    color: var(--ink-deep);
  }
  .comments-status { font-size: 0.82rem; margin-bottom: 0.6em; min-height: 1.2em; }
  .comments-status.err { color: var(--cinnabar); }
  .comments-status.ok { color: var(--ink-soft); }
  .comments-login { font-size: 0.9rem; color: var(--ink-mid); }
  .comments-login a { color: var(--cinnabar); }
  .comment-form { margin-bottom: 1.6em; }
  .comment-input {
    width: 100%;
    min-height: 4em;
    padding: 0.6em 0.8em;
    border: 1px solid var(--hairline);
    border-radius: 6px;
    background: var(--paper-card);
    font: inherit;
    resize: vertical;
  }
  .comment-form-row { display: flex; align-items: center; gap: 14px; margin-top: 8px; flex-wrap: wrap; }
  .comment-img-btn { font-size: 0.82rem; color: var(--ink-soft); cursor: pointer; }
  .comment-hint { font-size: 0.75rem; color: var(--ink-light); margin-left: auto; }
  .comment-attachments { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
  .comment-attach-thumb { width: 64px; height: 64px; object-fit: cover; border-radius: 6px; border: 1px solid var(--hairline); }
  .comments-list { list-style: none; margin: 0; padding: 0; }
  .comment { padding: 0.8em 0; border-bottom: 1px dashed var(--hairline); }
  .comment-head { display: flex; align-items: baseline; gap: 10px; margin-bottom: 4px; }
  .comment-floor { color: var(--ink-light); font-size: 0.75rem; }
  .comment-author { font-size: 0.85rem; color: var(--ink-deep); font-weight: 600; }
  .comment-time { font-size: 0.72rem; color: var(--ink-light); }
  .comment-body { font-size: 0.9rem; line-height: 1.7; color: var(--ink-deep); white-space: pre-wrap; word-break: break-word; }
  .comment-attach { margin-top: 6px; }
  .comment-img { max-width: 100%; max-height: 400px; border-radius: 6px; margin-top: 4px; }
  .comment-actions { margin-top: 6px; }
  .comment-replies { list-style: none; margin: 0.6em 0 0 1.4em; padding: 0; border-left: 2px solid var(--hairline); padding-left: 1em; }
  .comments-empty { color: var(--ink-light); font-size: 0.85rem; padding: 1em 0; }
</style>