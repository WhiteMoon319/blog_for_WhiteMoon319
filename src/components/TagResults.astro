---
import { envOf, getTagsUnion, fmtDate } from '../lib/db';
import { postHref } from '../lib/utils';

export const prerender = false;

interface Props {
  names: string[];
  keyword?: string;
}

const { names, keyword = '' } = Astro.props;
const env = await envOf();
const result = await getTagsUnion(env.DB, names, keyword);
const collections = result.collections;
const posts = result.posts;
const collectionPosts = result.collectionPosts;
const active = names.length > 0;
---

{
  collections.length > 0 && (
    <div class="tag-collections">
      {collections.map((c, i) => {
        const members = collectionPosts.get(c.id) ?? [];
        return (
          <details class="collection-block reveal" data-delay={String((i % 3) + 1)}>
            <summary>
              <div class="collection-title-row">
                <h3 class="post-title">{c.title}</h3>
                <span class="collection-meta">{c.post_count} 篇{active ? ` · ${names.join(' / ')}` : ''}</span>
              </div>
              {c.summary && <p class="post-summary">{c.summary}</p>}
            </summary>
            {members.length > 0 && (
              <div class="collection-anim">
                <ul class="collection-members">
                  {members.map((p) => (
                    <li>
                      <a href={postHref(p.slug, p.collection_slug)}>
                        {p.title}
                        <span class="member-date">{fmtDate(p.created_at)}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </details>
        );
      })}
    </div>
  )
}

{
  posts.length > 0 && (
    <>
      <div class="section-head" style="margin-top:44px;">
        <span class="kicker">文 章</span>
        <h2 class="section-title">{keyword ? '寻得的篇章' : '单篇'}</h2>
      </div>
      <div class="posts-grid">
        {posts.map((p, i) => (
          <a class="post-card reveal" data-delay={String((i % 3) + 1)} href={postHref(p.slug, p.collection_slug)}>
            <h3 class="post-title">{p.title}</h3>
            {p.summary && <p class="post-summary">{p.summary}</p>}
            <div class="post-meta">
              <span>{fmtDate(p.created_at)}</span>
            </div>
          </a>
        ))}
      </div>
    </>
  )
}

{
  collections.length === 0 && posts.length === 0 && (
    <p class="section-lead reveal in" style="text-align:center;">
      {keyword ? `未寻得「${keyword}」相关著作。` : active ? '此标签之下，尚无著作。' : '尚无文集与文章。'}
    </p>
  )
}

<style>
  .tag-collections {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 14px;
    max-width: 1080px;
    margin: 0 auto;
  }
  .collection-block {
    background: var(--paper-card);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    padding: 16px 20px;
    transition: border-color 0.2s ease;
  }
  .collection-block:hover {
    border-color: color-mix(in srgb, var(--cinnabar) 35%, transparent);
  }
  .collection-block summary {
    cursor: pointer;
    list-style: none;
    user-select: none;
    padding-left: 1.2em;
    position: relative;
  }
  .collection-block summary::-webkit-details-marker {
    display: none;
  }
  .collection-block summary::before {
    content: '▸';
    position: absolute;
    left: 0;
    top: 0.15em;
    color: var(--cc, var(--cinnabar));
    transition: transform 0.2s ease;
  }
  .collection-block[open] summary::before {
    transform: rotate(90deg);
  }
  .collection-block summary:hover .post-title {
    color: var(--cc, var(--cinnabar));
  }
  .collection-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .collection-title-row .post-title {
    margin: 0;
    font-size: 1.05rem;
  }
  .collection-meta {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--ink-light);
    white-space: nowrap;
  }
  .collection-title-row + .post-summary {
    margin: 6px 0 0;
    font-size: 0.85rem;
    color: var(--ink-mid);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .collection-anim {
    overflow: hidden;
    height: 0;
    transition: height 0.3s ease;
  }
  .collection-members {
    margin: 14px 0 0;
    padding: 12px 0 0;
    border-top: 1px dashed var(--hairline);
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .collection-members li {
    font-family: var(--font-serif);
    font-size: 0.92rem;
    line-height: 2.1;
  }
  .collection-members a {
    color: var(--ink-mid);
    text-decoration: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }
  .collection-members a:hover {
    color: var(--cc, var(--cinnabar));
    background: color-mix(in srgb, var(--cc, var(--cinnabar)) 6%, transparent);
  }
  .member-date {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--ink-light);
    white-space: nowrap;
  }
</style>

<script>
  // 文集卡开合动画：JS 生效时用高度过渡（无 JS 时 details 原生展开兜底）。
  // 全程保持具体 px 值——一旦写成 auto，auto→px 不可过渡，后续开合会失效。
  for (const details of document.querySelectorAll<HTMLDetailsElement>('details.collection-block')) {
    const inner = details.querySelector<HTMLElement>('.collection-anim');
    if (!inner) continue;
    if (!details.open) inner.style.height = '0px';
    details.addEventListener('toggle', () => {
      if (details.open) {
        const target = inner.scrollHeight;
        inner.style.height = '0px';
        void inner.offsetHeight;
        inner.style.height = `${target}px`;
      } else {
        inner.style.height = `${inner.scrollHeight}px`;
        void inner.offsetHeight;
        inner.style.height = '0px';
      }
    });
    inner.addEventListener('transitionend', () => {
      if (details.open) inner.style.height = `${inner.scrollHeight}px`;
    });
  }
  // 窗口尺寸变化后重算已展开卡片的展开高度，避免内容被裁剪
  window.addEventListener('resize', () => {
    for (const details of document.querySelectorAll<HTMLDetailsElement>('details.collection-block[open]')) {
      const inner = details.querySelector<HTMLElement>('.collection-anim');
      if (inner) inner.style.height = `${inner.scrollHeight}px`;
    }
  });
</script>
