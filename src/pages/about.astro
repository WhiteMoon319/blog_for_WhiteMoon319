import StandaloneTemplate from '@theme/templates/standalone.astro';
import { envOf } from '../lib/db';
import { getPageBySlug } from '../lib/db/pages.ts';
import { renderMarkdown } from '../lib/markdown.ts';

const env = await envOf();
const dbPage = await getPageBySlug(env.DB, 'about');

const pageTitle = dbPage?.title || '关于';
const pageDesc = `关于「${env.SITE_NAME}」`;
const bodyHtml = dbPage?.published === 1
  ? renderMarkdown(dbPage.content_md).html
  : null;
// 缺页兜底文案（原 about 页内置区块，经 props 下传模板）
const fallbackHtml = `<p>
            吾名江逐月，亦可称吾江榫。闲散时，多提笔勾勒三两闲言，望各位客官看个尽兴。
          </p>
          <blockquote>希君生羽翼，一化北溟鱼。</blockquote>
          <p>
            如若相谈，可联系 <a href="mailto:3287047638@qq.com">3287047638@qq.com</a>。
          </p>`;
import { getSiteContext } from "../lib/theme-context";
const siteCtx = await getSiteContext(Astro);
---

<StandaloneTemplate
  ctx={siteCtx}
  title={pageTitle}
  description={pageDesc}
  hero={{ kicker: '跋', lead: env.SITE_SLOGAN }}
  html={bodyHtml}
  fallbackHtml={fallbackHtml}
/>
