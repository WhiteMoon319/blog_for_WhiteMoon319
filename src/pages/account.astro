import BaseLayout from '@theme/layouts/BaseLayout.astro';
import { envOf } from '../lib/db';
const env = await envOf();
import { getSiteContext } from "../lib/theme-context";
const siteCtx = await getSiteContext(Astro);
---

<BaseLayout ctx={siteCtx} title="个人中心" noindex>
  <div class="account-page">
    <div class="account-card">
      <h1>个人中心</h1>

      <div id="me-box" style="display:none;">
        <!-- 头像 + 昵称 -->
        <div class="acc-header">
          <img id="avatar-img" class="acc-avatar" src="" alt="头像" style="display:none;" />
          <div>
            <p class="acc-username" id="acc-username"></p>
            <p class="acc-role" id="acc-role"></p>
          </div>
        </div>

        <!-- 修改昵称 -->
        <div class="auth-field">
          <label for="display_name">昵称（评论与文章显示名）</label>
          <input id="display_name" class="input" />
        </div>

        <!-- 头像上传 -->
        <div class="auth-field">
          <label>更换头像</label>
          <input id="avatar-file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" />
        </div>

        <!-- 邮箱 -->
        <div class="auth-field">
          <label for="email">邮箱</label>
          <input id="email" class="input" type="email" />
          <span class="hint" id="email-state"></span>
        </div>

        <!-- 邮件提醒开关 -->
        <div class="auth-field" style="display:flex;gap:8px;align-items:center;">
          <input id="notify_email" type="checkbox" />
          <label for="notify_email" style="margin:0;">收到新回复/新赞时邮件提醒</label>
        </div>

        <button id="save-btn" class="btn btn-primary" type="button" style="width:100%;justify-content:center;">保存资料</button>
        <p id="save-error" class="auth-error" style="display:none;"></p>

        <hr style="border:none;border-top:1px solid var(--hairline);margin:1.5em 0;" />

        <!-- 修改密码 -->
        <h2 style="font-size:1rem;margin:0 0 0.8em;">修改密码</h2>
        <div class="auth-field">
          <label for="old_password">原密码</label>
          <input id="old_password" class="input" type="password" autocomplete="current-password" />
        </div>
        <div class="auth-field">
          <label for="new_password">新密码（至少 8 位，含字母和数字/特殊字符）</label>
          <input id="new_password" class="input" type="password" autocomplete="new-password" />
        </div>
        <button id="pwd-btn" class="btn btn-primary" type="button" style="width:100%;justify-content:center;">更新密码</button>
        <p id="pwd-error" class="auth-error" style="display:none;"></p>

        <p class="auth-alt"><a href="/logout/">退出登录</a> · <a href="/">返回首页</a></p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  interface AccountInfo {
    id: number;
    username: string;
    display_name: string;
    email: string;
    email_verified: boolean;
    avatar_url: string;
    role: string;
    notify_email: boolean;
  }
  async function me(): Promise<AccountInfo | null> {
    const r = await fetch('/api/account', { credentials: 'same-origin' });
    if (r.status === 401) { location.href = '/login/?redirect=/account/'; return null; }
    return r.json() as Promise<AccountInfo>;
  }
  const err = (el: HTMLElement, msg: string) => { el.textContent = msg; el.style.display = 'block'; };
  const clear = (el: HTMLElement) => { el.style.display = 'none'; };

  const u = await me();
  if (u) {
    (document.getElementById('me-box') as HTMLElement).style.display = 'block';
    (document.getElementById('acc-username') as HTMLElement).textContent = '@' + u.username;
    (document.getElementById('acc-role') as HTMLElement).textContent = u.role === 'admin' ? '管理员' : u.role === 'author' ? '作者' : '读者';
    (document.getElementById('display_name') as HTMLInputElement).value = u.display_name;
    (document.getElementById('email') as HTMLInputElement).value = u.email;
    (document.getElementById('notify_email') as HTMLInputElement).checked = !!u.notify_email;
    const av = document.getElementById('avatar-img') as HTMLImageElement;
    if (u.avatar_url) av.src = u.avatar_url;
    else { av.style.display = 'none'; }
    (document.getElementById('email-state') as HTMLElement).textContent = u.email_verified ? '（已验证）' : '（未验证，改邮箱需重新验证）';

    const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
    const saveError = document.getElementById('save-error') as HTMLElement;
    let avatarUrl = u.avatar_url ?? '';

    // 头像上传
    const fileInput = document.getElementById('avatar-file') as HTMLInputElement;
    fileInput.addEventListener('change', async () => {
      const f = fileInput.files?.[0];
      if (!f) return;
      const fd = new FormData(); fd.append('file', f);
      const res = await fetch('/api/account/avatar', { method: 'POST', credentials: 'same-origin', body: fd });
      const data = await res.json() as { url?: string; error?: string };
      if (!res.ok || !data.url) { err(saveError, data.error ?? '上传失败'); return; }
      const av = document.getElementById('avatar-img') as HTMLImageElement;
      av.style.display = 'inline-block';
      av.src = data.url;
      avatarUrl = data.url;
      clear(saveError);
    });

    saveBtn.addEventListener('click', async () => {
      clear(saveError);
      const payload: Record<string, unknown> = {
        display_name: (document.getElementById('display_name') as HTMLInputElement).value,
        notify_email: (document.getElementById('notify_email') as HTMLInputElement).checked,
        email: (document.getElementById('email') as HTMLInputElement).value,
      };
      if (avatarUrl !== (u.avatar_url ?? '')) payload.avatar_url = avatarUrl;
      const res = await fetch('/api/account', {
        method: 'PUT', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json() as { error?: string };
      if (!res.ok) { err(saveError, data.error ?? '保存失败'); return; }
      saveBtn.textContent = '已保存';
      setTimeout(() => { saveBtn.textContent = '保存资料'; }, 1500);
    });

    // 修改密码
    const pwdBtn = document.getElementById('pwd-btn') as HTMLButtonElement;
    const pwdError = document.getElementById('pwd-error') as HTMLElement;
    pwdBtn.addEventListener('click', async () => {
      clear(pwdError);
      const old = (document.getElementById('old_password') as HTMLInputElement).value;
      const neu = (document.getElementById('new_password') as HTMLInputElement).value;
      const res = await fetch('/api/account/password', {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ old_password: old, new_password: neu }),
      });
      const data = await res.json() as { error?: string; message?: string };
      if (!res.ok) { err(pwdError, data.error ?? '更新失败'); return; }
      pwdBtn.textContent = '已更新，请重新登录';
      setTimeout(() => { location.href = '/login/'; }, 1200);
    });
  }
</script>

<style>
  .account-page { max-width: 460px; margin: 3em auto; padding: 0 20px; }
  .account-card { background: var(--paper-card); border: 1px solid var(--hairline); border-radius: 12px; padding: 2.5em 2em; box-shadow: 0 10px 30px rgba(0,0,0,0.04); }
  .account-card h1 { font-family: var(--font-brush); font-size: 1.5rem; font-weight: 400; letter-spacing: 0.15em; text-align: center; margin: 0 0 1.4em; color: var(--ink-deep); }
  .acc-header { display: flex; align-items: center; gap: 16px; margin-bottom: 1.4em; }
  .acc-avatar { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; border: 2px solid var(--hairline); }
  .acc-username { font-size: 1rem; font-weight: 600; color: var(--ink-deep); margin: 0; }
  .acc-role { font-size: 0.78rem; color: var(--ink-light); margin: 2px 0 0; }
  .auth-field { margin-bottom: 1em; }
  .auth-field label { display: block; font-size: 0.82rem; color: var(--ink-mid); margin-bottom: 5px; }
  .auth-field .input { width: 100%; box-sizing: border-box; }
  .auth-field .hint { font-size: 0.75rem; color: var(--ink-light); margin-top: 4px; }
  .auth-error { color: var(--cinnabar); font-size: 0.85rem; margin-top: 0.8em; text-align: center; }
  .auth-alt { text-align: center; font-size: 0.82rem; color: var(--ink-light); margin-top: 1.4em; }
  .auth-alt a { color: var(--cinnabar); }
</style>