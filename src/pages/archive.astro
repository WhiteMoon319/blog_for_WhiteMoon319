import BaseLayout from '../layouts/BaseLayout.astro';
import Pagination from '../components/Pagination.astro';
import { envOf, listArchivedPosts, countArchivedPosts, getCollectionsByIds, yearOf, fmtDate } from '../lib/db';
import { postHref } from '../lib/utils';

export const prerender = false;

const PAGE_SIZE = 20;
const env = await envOf();
const pageRaw = Number(Astro.url.searchParams.get('page') ?? '1');
const safeRaw = Number.isFinite(pageRaw) && pageRaw >= 1 ? Math.floor(pageRaw) : 1;
const total = await countArchivedPosts(env.DB);
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
const page = Math.min(safeRaw, totalPages);
const posts = await listArchivedPosts(env.DB, { limit: PAGE_SIZE, offset: (page - 1) * PAGE_SIZE });

const groups: {
  year: string;
  posts: { post: typeof posts[number]; collection: { slug: string; title: string } | null }[];
}[] = [];
const collections = await getCollectionsByIds(env.DB, posts.map((p) => p.collection_id ?? 0));
for (const post of posts) {
  const year = yearOf(post.created_at);
  const collection = post.collection_id ? collections.get(post.collection_id) ?? null : null;
  const last = groups[groups.length - 1];
  if (last && last.year === year) {
    last.posts.push({ post, collection });
  } else {
    groups.push({ year, posts: [{ post, collection }] });
  }
}
---

<BaseLayout title="归档" description="全部文章按时间铺陈。">
  <div class="page-hero">
    <a class="page-back reveal in" href="/">← 回到卷首</a>
    <div class="page-hero-card reveal in">
      <p class="character-kicker">档 案</p>
      <h1>文章归档</h1>
      <p class="lead">共 {total} 篇，按落笔先后铺陈。</p>
    </div>
  </div>

  <section class="section" style="padding-top:56px;">
    {
      groups.length > 0 ? (
        <div class="timeline">
          {groups.map((g) => (
            <>
              <div class="tl-era">{g.year} 年 <small>共 {g.posts.length} 篇</small></div>
              {g.posts.map(({ post, collection }) => (
                <div class="tl-item">
                  <a href={postHref(post.slug, collection?.slug)}>
<div class="tl-event">{collection?.title ?? '未分类'} · {post.title}</div>
                <div class="tl-desc">{fmtDate(post.created_at)}{post.summary ? ` · ${post.summary}` : ''}</div>
                  </a>
                </div>
              ))}
            </>
          ))}
        </div>
      ) : (
        <p class="section-lead reveal in" style="text-align:center;">尚无文章。</p>
      )
    }
    <Pagination current={page} totalPages={totalPages} base="/archive/" query="" />
  </section>
</BaseLayout>