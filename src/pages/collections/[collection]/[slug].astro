// 文集文章已从 /collections/{collection}/{slug}/ 扁平化为 /{collection}/{slug}/，保留 301
export const prerender = false;
const { collection, slug } = Astro.params;
const q = Astro.url.search;
return Astro.redirect(`/${encodeURI(collection ?? '')}/${encodeURI(slug ?? '')}/${q}`, 301);
