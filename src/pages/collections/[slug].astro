import CollectionTemplate from '@theme/templates/collection.astro';
import { envOf, getCollectionBySlug, listPublishedPosts, countPublishedPosts } from '../../lib/db';
import { safeJsonLd } from '../../lib/seo';
import { postHref } from '../../lib/utils';

export const prerender = false;

const PAGE_SIZE = 12;
const env = await envOf();
const { slug } = Astro.params;
const collection = slug ? await getCollectionBySlug(env.DB, slug) : null;

if (!collection) {
  return Astro.redirect('/404');
}

const pageRaw = Number(Astro.url.searchParams.get('page') ?? '1');
const safeRaw = Number.isFinite(pageRaw) && pageRaw >= 1 ? Math.floor(pageRaw) : 1;
const total = await countPublishedPosts(env.DB, { collectionId: collection.id });
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
const page = Math.min(safeRaw, totalPages);
const posts = await listPublishedPosts(env.DB, {
  collectionId: collection.id,
  limit: PAGE_SIZE,
  offset: (page - 1) * PAGE_SIZE,
  order: collection.post_order,
});
const siteUrl = env.SITE_URL.replace(/\/$/, '');
const collectionUrl = `${siteUrl}/collections/${encodeURI(collection.slug)}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: collection.title,
  description: collection.summary || undefined,
  url: collectionUrl,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: posts.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.title,
      url: `${siteUrl}${postHref(p.slug, collection.slug)}`,
    })),
  },
};
import { getSiteContext } from "../../lib/theme-context";
const siteCtx = await getSiteContext(Astro);
---

<CollectionTemplate
  ctx={siteCtx}
  jsonLd={safeJsonLd(jsonLd)}
  collection={collection}
  posts={posts}
  total={total}
  page={page}
  totalPages={totalPages}
/>
