// 文集已从 /collections/{slug}/ 扁平化为 /{slug}/，此处保留 301 以免旧链接失效、权重分散
export const prerender = false;
const { slug } = Astro.params;
const q = Astro.url.search;
return Astro.redirect(`/${encodeURI(slug ?? '')}/${q}`, 301);
