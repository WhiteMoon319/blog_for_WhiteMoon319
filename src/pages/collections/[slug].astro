import BaseLayout from '../../layouts/BaseLayout.astro';
import Pagination from '../../components/Pagination.astro';
import { envOf, getCollectionBySlug, listPublishedPosts, countPublishedPosts, fmtDate } from '../../lib/db';
import { safeJsonLd } from '../../lib/seo';
import { postHref } from '../../lib/utils';

export const prerender = false;

const PAGE_SIZE = 12;
const env = await envOf();
const { slug } = Astro.params;
const collection = slug ? await getCollectionBySlug(env.DB, slug) : null;

if (!collection) {
  return Astro.redirect('/404');
}

const pageRaw = Number(Astro.url.searchParams.get('page') ?? '1');
const safeRaw = Number.isFinite(pageRaw) && pageRaw >= 1 ? Math.floor(pageRaw) : 1;
const total = await countPublishedPosts(env.DB, { collectionId: collection.id });
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
const page = Math.min(safeRaw, totalPages);
const posts = await listPublishedPosts(env.DB, {
  collectionId: collection.id,
  limit: PAGE_SIZE,
  offset: (page - 1) * PAGE_SIZE,
  order: collection.post_order,
});
const siteUrl = env.SITE_URL.replace(/\/$/, '');
const collectionUrl = `${siteUrl}/collections/${encodeURI(collection.slug)}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: collection.title,
  description: collection.summary || undefined,
  url: collectionUrl,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: posts.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.title,
      url: `${siteUrl}${postHref(p.slug, collection.slug)}`,
    })),
  },
};
---

<BaseLayout title={collection.title} description={collection.summary}>
  <script type="application/ld+json" set:html={safeJsonLd(jsonLd)} />
  <div class="page-hero" style={`--cc: ${collection.theme_color};`}>
    <a class="page-back reveal in" href="/">← 回到卷首</a>

    <div class="page-hero-card reveal in">
      <p class="character-kicker">文 集</p>
      <h1>{collection.title}</h1>
      {collection.summary && <p class="lead">{collection.summary}</p>}
      <div class="facts">
        <span>{total} 篇</span>
        <span>序 {collection.sort_order}</span>
      </div>
    </div>
  </div>

  <section class="section" style="padding-top:56px;">
    {
      posts.length > 0 ? (
        <div class="posts-grid">
          {posts.map((p, i) => (
            <a class="post-card reveal" data-delay={String((i % 3) + 1)} href={postHref(p.slug, collection.slug)} style={`--cc: ${collection.theme_color};`}>
              {p.cover_url && <img class="post-cover" src={p.cover_url} alt="" loading="lazy" decoding="async" />}
              <h3 class="post-title">{p.title}</h3>
              {p.summary && <p class="post-summary">{p.summary}</p>}
              <div class="post-meta">
                <span class="post-tag">{collection.title}</span>
                <span>{fmtDate(p.created_at)}</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="section-lead reveal in" style="text-align:center;">此集尚空，静候主人落笔。</p>
      )
    }
    <Pagination current={page} totalPages={totalPages} base={`/collections/${collection.slug}/`} query="" />
  </section>
</BaseLayout>