import BaseLayout from '../layouts/BaseLayout.astro';
import { envOf } from '../lib/db';
const env = await envOf();
const redirect = Astro.url.searchParams.get('redirect') ?? '/';
---

<BaseLayout title="登录" noindex>
  <div class="auth-page">
    <div class="auth-card">
      <h1>登 录</h1>
      <p class="sub">{env.SITE_NAME}</p>
      <form id="login-form">
        <div class="auth-field">
          <label for="username">用户名 / 邮箱</label>
          <input id="username" name="username" class="input" placeholder="username 或 email" autocomplete="username" required />
        </div>
        <div class="auth-field">
          <label for="password">密码</label>
          <input id="password" name="password" class="input" type="password" placeholder="密码" autocomplete="current-password" required />
        </div>
        <button class="btn btn-primary" type="submit" style="width:100%;justify-content:center;">登 录</button>
        <p id="login-error" class="auth-error" style="display:none;"></p>
      </form>
      <p class="auth-alt">
        还没有账号？<a href="/register/">注册</a> ·
        管理员请用管理员账号登录，后台入口 <a href="/admin/">/admin</a>
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('login-form')!;
  const errEl = document.getElementById('login-error')!;
  const redirect = new URLSearchParams(location.search).get('redirect') ?? '/';

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form as HTMLFormElement);
    errEl.style.display = 'none';
    try {
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username: fd.get('username'), password: fd.get('password') }),
      });
      const data = await res.json();
      if (!res.ok) {
        errEl.textContent = res.status === 429 ? '尝试过于频繁，请稍后再试。' : (data.error === 'account disabled' ? '账号已被停用。' : '用户名或密码错误。');
        errEl.style.display = 'block';
        return;
      }
      location.href = redirect;
    } catch {
      errEl.textContent = '网络错误，请重试。';
      errEl.style.display = 'block';
    }
  });
</script>

<style>
  .auth-page { max-width: 420px; margin: 4em auto; padding: 0 20px; }
  .auth-card {
    background: var(--paper-card);
    border: 1px solid var(--hairline);
    border-radius: 12px;
    padding: 2.5em 2em;
    box-shadow: 0 10px 30px rgba(0,0,0,0.04);
  }
  .auth-card h1 { font-family: var(--font-brush); font-size: 1.6rem; font-weight: 400; letter-spacing: 0.15em; text-align: center; margin: 0 0 4px; color: var(--ink-deep); }
  .auth-card .sub { text-align: center; color: var(--ink-light); font-size: 0.8rem; letter-spacing: 0.2em; margin: 0 0 1.6em; }
  .auth-field { margin-bottom: 1em; }
  .auth-field label { display: block; font-size: 0.82rem; color: var(--ink-mid); margin-bottom: 5px; }
  .auth-field .input { width: 100%; box-sizing: border-box; }
  .auth-error { color: var(--cinnabar); font-size: 0.85rem; margin-top: 0.8em; text-align: center; }
  .auth-alt { text-align: center; font-size: 0.82rem; color: var(--ink-light); margin-top: 1.4em; }
  .auth-alt a { color: var(--cinnabar); }
</style>