import { envOf } from '../../lib/db/index.ts';
import { getPageBySlug } from '../../lib/db/pages.ts';
import { renderMarkdown } from '../../lib/markdown.ts';
import BaseLayout from '@theme/layouts/BaseLayout.astro';
import ArticleEnhancer from '@theme/components/ArticleEnhancer.astro';

export const prerender = false;

const env = await envOf();
const page = await getPageBySlug(env.DB, Astro.params.slug!);

if (!page || page.published !== 1) return new Response(null, { status: 404 });

const { html } = renderMarkdown(page.content_md);
import { getSiteContext } from "../../lib/theme-context";
const siteCtx = await getSiteContext(Astro);
---

<BaseLayout ctx={siteCtx} title={page.title}>
  <article class="page-content">
    <div class="page-head">
      <h1>{page.title}</h1>
    </div>
    <Fragment set:html={html} />
  </article>
  <ArticleEnhancer html={html} />
</BaseLayout>