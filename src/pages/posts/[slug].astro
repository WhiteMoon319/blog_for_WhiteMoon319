---
// 月下独酌 · blog（blog_for_WhiteMoon319）
// Copyright (C) 2026 WhiteMoon319 · AGPL-3.0-or-later · 源码见 https://github.com/WhiteMoon319/blog_for_WhiteMoon319
import BaseLayout from '../../layouts/BaseLayout.astro';
import { envOf, getPublishedPostBySlug, getPublishedPostBySlugAny, getAdjacentPosts, incrementViewCount, recordDailyView, listPostEffectiveTags, getCollectionById, fmtDate } from '../../lib/db';
import { renderMarkdown } from '../../lib/markdown';
import ArticleEnhancer from '../../components/ArticleEnhancer.astro';
import Comments from '../../components/Comments.astro';
import PostLike from '../../components/PostLike.astro';
import { resolveUser } from '../../lib/auth';
import { safeJsonLd } from '../../lib/seo';

const env = await envOf();
const siteUrl = env.SITE_URL.replace(/\/$/, '');
const { slug } = Astro.params;
const post = slug ? await getPublishedPostBySlug(env.DB, slug) : null;

if (!post) {
  // 旧路径可能指向已收入文集的文章：查全站已刊同名文章，永久 301 到文集路径，避免链接权分散
  const anyPost = slug ? await getPublishedPostBySlugAny(env.DB, slug) : null;
  if (anyPost && anyPost.collection_id !== null) {
    const collection = await getCollectionById(env.DB, anyPost.collection_id);
    return Astro.redirect(
      `/collections/${encodeURI(collection?.slug ?? '')}/${encodeURI(anyPost.slug)}/`,
      301,
    );
  }
  return Astro.redirect('/404');
}

const viewCount = await incrementViewCount(env.DB, post.id);
await recordDailyView(env.DB, post.id, Astro.request);
const effectiveTags = await listPostEffectiveTags(env.DB, post.id);
const { prev, next } = await getAdjacentPosts(env.DB, post);
const { html, toc } = renderMarkdown(post.content_md);
// 文章点赞：计数 + 当前用户是否已赞
const user = await resolveUser(Astro);
const likeCount = await env.DB.prepare('SELECT COUNT(*) AS n FROM post_likes WHERE post_id = ?').bind(post.id).first<{ n: number }>();
const liked = !!user && !!(await env.DB.prepare('SELECT 1 FROM post_likes WHERE post_id = ? AND user_id = ?').bind(post.id, user.user.id).first());
const postHref = (s: string, collectionSlug?: string | null) =>
  collectionSlug ? `/collections/${encodeURI(collectionSlug)}/${encodeURI(s)}/` : `/posts/${encodeURI(s)}/`;
const ABSOLUTE_URL_RE = /^(https?:|data:|blob:)/i;
const postUrl = `${siteUrl}/posts/${encodeURI(post.slug)}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.summary || undefined,
  datePublished: post.created_at,
  dateModified: post.updated_at,
  url: postUrl,
  mainEntityOfPage: postUrl,
  keywords: post.meta_keywords || undefined,
  image: post.cover_url
    ? ABSOLUTE_URL_RE.test(post.cover_url)
      ? post.cover_url
      : `${siteUrl}/${post.cover_url.replace(/^\//, '')}`
    : undefined,
  author: { '@type': 'Person', name: env.SITE_NAME },
  publisher: { '@type': 'Organization', name: env.SITE_NAME },
};
---

<BaseLayout title={post.title} description={post.summary} keywords={post.meta_keywords}>
  <script type="application/ld+json" set:html={safeJsonLd(jsonLd)} />
  <div class="page-hero" style="--cc: #c23a30;">
    <a class="page-back reveal in" href="/">← 回到卷首</a>

    <div class="page-hero-card reveal in">
      <p class="character-kicker">未分类 · {fmtDate(post.created_at)}</p>
      <h1>{post.title}</h1>
      {post.summary && <p class="lead">{post.summary}</p>}
      <div class="facts">
        <span>成于 {fmtDate(post.created_at)}</span>
        {post.updated_at !== post.created_at && <span>改于 {fmtDate(post.updated_at)}</span>}
        <span>阅 {viewCount}</span>
      </div>
      {effectiveTags.length > 0 && (
        <div class="facts tag-row">
          {effectiveTags.map((t) => (
            <a class="tag-chip" href={`/tags/${encodeURIComponent(t.name)}/`}>{t.name}</a>
          ))}
        </div>
      )}
    </div>
  </div>

  <article class="article">
    {post.cover_url && <img class="article-cover" src={post.cover_url} alt="" loading="eager" decoding="async" />}
    <div class="article-body reveal in" set:html={html} />

    {toc.length > 1 && (
      <nav class="article-toc" aria-label="目录">
        <p class="toc-title">目 录</p>
        <ol>
          {toc.map((t) => (
            <li class={`toc-lv${t.level}`}>
              <a href={`#${t.id}`}>{t.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <nav class="article-pagination">
      {prev && <a class="btn btn-ghost" href={postHref(prev.slug, prev.collection_slug)}>← {prev.title}</a>}
      {next && <a class="btn btn-ghost" href={postHref(next.slug, next.collection_slug)}>{next.title} →</a>}
    </nav>
  </article>
  <PostLike postId={post.id} likes={likeCount?.n ?? 0} liked={liked} />
  <Comments postId={post.id} />
  <ArticleEnhancer />
</BaseLayout>