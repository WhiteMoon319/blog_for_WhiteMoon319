---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { envOf, getCollectionById, getPublishedPostBySlug, getAdjacentPosts, fmtDate } from '../../lib/db';
import { renderMarkdown } from '../../lib/markdown';

const env = await envOf();
const { slug } = Astro.params;
const post = slug ? await getPublishedPostBySlug(env.DB, slug) : null;

if (!post) {
  return Astro.redirect('/404');
}

const collection = post.collection_id ? await getCollectionById(env.DB, post.collection_id) : null;
const { prev, next } = await getAdjacentPosts(env.DB, post);
const { html, toc } = renderMarkdown(post.content_md);
const postHref = (s: string) => `/posts/${encodeURI(s)}/`;
const collectionHref = collection ? `/collections/${encodeURI(collection.slug)}/` : '/';
---

<BaseLayout title={post.title} description={post.summary}>
  <div class="page-hero" style={`--cc: ${collection?.theme_color ?? '#c23a30'};`}>
    <a class="page-back reveal in" href={collectionHref}>
      ← {collection ? collection.title : '回到卷首'}
    </a>

    <div class="page-hero-card reveal in">
      <p class="character-kicker">{collection?.title ?? '未分类'} · {fmtDate(post.created_at)}</p>
      <h1>{post.title}</h1>
      {post.summary && <p class="lead">{post.summary}</p>}
      <div class="facts">
        <span>成于 {fmtDate(post.created_at)}</span>
        {post.updated_at !== post.created_at && <span>改于 {fmtDate(post.updated_at)}</span>}
      </div>
    </div>
  </div>

  <article class="article">
    {post.cover_url && <img class="article-cover" src={post.cover_url} alt="" loading="eager" decoding="async" />}
    <div class="article-body reveal in" set:html={html} />

    {toc.length > 1 && (
      <nav class="article-toc" aria-label="目录">
        <p class="toc-title">目 录</p>
        <ol>
          {toc.map((t) => (
            <li class={`toc-lv${t.level}`}>
              <a href={`#${t.id}`}>{t.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <nav class="article-pagination">
      {prev && <a class="btn btn-ghost" href={postHref(prev.slug)}>← {prev.title}</a>}
      {next && <a class="btn btn-ghost" href={postHref(next.slug)}>{next.title} →</a>}
    </nav>
  </article>
</BaseLayout>