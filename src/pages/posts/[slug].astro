---
// 月下独酌 · blog（blog_for_WhiteMoon319）
// Copyright (C) 2026 WhiteMoon319 · AGPL-3.0-or-later · 源码见 https://github.com/WhiteMoon319/blog_for_WhiteMoon319
import { envOf, getPublishedPostBySlug, getPublishedPostBySlugAny, getAdjacentPosts, incrementViewCount, recordDailyView, listPostEffectiveTags, getCollectionById } from '../../lib/db';
import { renderMarkdown } from '../../lib/markdown';
import { resolveUser } from '../../lib/auth';
import { safeJsonLd } from '../../lib/seo';
import PostTemplate from '@theme/templates/post.astro';
import { getSiteContext } from "../../lib/theme-context";

const env = await envOf();
const siteUrl = env.SITE_URL.replace(/\/$/, '');
const { slug } = Astro.params;
const post = slug ? await getPublishedPostBySlug(env.DB, slug) : null;

if (!post) {
  // 旧路径可能指向已收入文集的文章：查全站已刊同名文章，永久 301 到文集路径，避免链接权分散
  const anyPost = slug ? await getPublishedPostBySlugAny(env.DB, slug) : null;
  if (anyPost && anyPost.collection_id !== null) {
    const collection = await getCollectionById(env.DB, anyPost.collection_id);
    return Astro.redirect(
      `/collections/${encodeURI(collection?.slug ?? '')}/${encodeURI(anyPost.slug)}/`,
      301,
    );
  }
  return Astro.redirect('/404');
}

const viewCount = await incrementViewCount(env.DB, post.id);
await recordDailyView(env.DB, post.id, Astro.request);
const effectiveTags = await listPostEffectiveTags(env.DB, post.id);
const { prev, next } = await getAdjacentPosts(env.DB, post);
const { html, toc } = renderMarkdown(post.content_md);
// 文章点赞：计数 + 当前用户是否已赞
const user = await resolveUser(Astro);
const likeCount = await env.DB.prepare('SELECT COUNT(*) AS n FROM post_likes WHERE post_id = ?').bind(post.id).first<{ n: number }>();
const liked = !!user && !!(await env.DB.prepare('SELECT 1 FROM post_likes WHERE post_id = ? AND user_id = ?').bind(post.id, user.user.id).first());
const ABSOLUTE_URL_RE = /^(https?:|data:|blob:)/i;
const postUrl = `${siteUrl}/posts/${encodeURI(post.slug)}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.summary || undefined,
  datePublished: post.created_at,
  dateModified: post.updated_at,
  url: postUrl,
  mainEntityOfPage: postUrl,
  keywords: post.meta_keywords || undefined,
  image: post.cover_url
    ? ABSOLUTE_URL_RE.test(post.cover_url)
      ? post.cover_url
      : `${siteUrl}/${post.cover_url.replace(/^\//, '')}`
    : undefined,
  author: { '@type': 'Person', name: env.SITE_NAME },
  publisher: { '@type': 'Organization', name: env.SITE_NAME },
};
const siteCtx = await getSiteContext(Astro);
---

<PostTemplate
  ctx={siteCtx}
  postId={post.id}
  title={post.title}
  summary={post.summary}
  coverUrl={post.cover_url}
  keywords={post.meta_keywords}
  createdAt={post.created_at}
  updatedAt={post.updated_at}
  viewCount={viewCount}
  html={html}
  toc={toc}
  tags={effectiveTags}
  prev={prev}
  next={next}
  likes={likeCount?.n ?? 0}
  liked={liked}
  accentColor="#c23a30"
  backHref="/"
  backLabel="← 回到卷首"
  kicker="未分类"
  jsonLd={safeJsonLd(jsonLd)}
/>
