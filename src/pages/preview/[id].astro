import { envOf, getPostById, getCollectionById } from '../../lib/db';
import { postHref } from '../../lib/utils';
import { renderMarkdown } from '../../lib/markdown';
import { resolveUser } from '../../lib/auth';
import { canManagePost } from '../../lib/api/post-access.ts';
import { listPostAuthorBadges } from '../../lib/authors-view';
import PostTemplate from '@theme/templates/post.astro';
import { getSiteContext } from "../../lib/theme-context";

export const prerender = false;

const env = await envOf();
const user = await resolveUser(Astro);
if (!user) {
  return Astro.redirect('/admin/login');
}

const id = Number(Astro.params.id);
const post = Number.isInteger(id) && id > 0 ? await getPostById(env.DB, id) : null;
if (!post) {
  return Astro.redirect('/404');
}
// 草稿预览与编辑同权：归属人 / 署名作者 / 管理员，其余按不存在处理
if (!(await canManagePost(env.DB, user.user, post))) {
  return Astro.redirect('/404');
}

const collection = post.collection_id ? await getCollectionById(env.DB, post.collection_id) : null;
const { html, toc } = renderMarkdown(post.content_md);
const theme = collection?.theme_color ?? '#8a6d3b';

const backHref = collection ? `/collections/${encodeURI(collection.slug)}/` : '/archive/';
const backLabel = collection ? `← ${collection.title}` : '← 归档';
const kicker = collection?.title ?? '未分类';
const publishedHref =
  post.status === 'published' && collection ? postHref(post.slug, collection.slug) : undefined;

const siteCtx = await getSiteContext(Astro);
// 草稿预览同样展示署名，方便作者确认最终署名效果
const authors = await listPostAuthorBadges(env.DB, post.id);
---

<PostTemplate
  ctx={siteCtx}
  isPreview
  previewBadgeText={post.status === 'draft' ? '（未刊发）' : '（已刊发）'}
  postId={post.id}
  title={post.title}
  summary={post.summary}
  coverUrl={post.cover_url}
  createdAt={post.created_at}
  updatedAt={post.updated_at}
  viewCount={post.view_count}
  html={html}
  toc={toc}
  accentColor={theme}
  backHref={backHref}
  backLabel={backLabel}
  kicker={kicker}
  authors={authors}
  ogImage={post.cover_url ? post.cover_url : undefined}
  noindex
  publishedHref={publishedHref}
/>
