---
import BaseLayout from '../layouts/BaseLayout.astro';
import { envOf, searchPublishedPosts, getCollectionsByIds, getTagPage, fmtDate } from '../lib/db';
import { postHref } from '../lib/utils';

export const prerender = false;

const env = await envOf();
const q = (Astro.url.searchParams.get('q') ?? '').trim();

// 「#标签 [关键词]」为标签检索：#校园 → 转标签聚合页；#校园 庄桂清 → 在标签内按关键词寻章；
// 仅带 #、无此标签或未指定标签时按普通检索处理
let tagMode = false;
let tagNotFound = '';
if (q.startsWith('#') && q.length > 1) {
  const rest = q.slice(1).trim();
  const splitAt = rest.search(/\s/);
  const tagName = (splitAt === -1 ? rest : rest.slice(0, splitAt)).trim();
  const keyword = splitAt === -1 ? '' : rest.slice(splitAt + 1).trim();
  if (tagName) {
    tagMode = true;
    const page = await getTagPage(env.DB, tagName, keyword);
    if (page) {
      const target = `/tags/${encodeURIComponent(tagName)}/${keyword ? `?q=${encodeURIComponent(keyword)}` : ''}`;
      return Astro.redirect(target);
    }
    tagNotFound = tagName;
  }
}

const posts = q ? await searchPublishedPosts(env.DB, q) : [];
const collections = await getCollectionsByIds(env.DB, posts.map((p) => p.collection_id ?? 0));
const results: { post: (typeof posts)[number]; collection: { slug: string; title: string; theme_color: string } | null }[] = [];
for (const post of posts) {
  const collection = post.collection_id ? collections.get(post.collection_id) ?? null : null;
  results.push({ post, collection });
}
---

<BaseLayout title="寻章" description="站内搜索">
  <div class="page-hero">
    <a class="page-back reveal in" href="/">← 回到卷首</a>
    <div class="page-hero-card reveal in">
      <p class="character-kicker">寻</p>
      <h1>寻章摘句</h1>
      <p class="lead">于卷帙之间，觅得一言。</p>
    </div>
  </div>

  <section class="section" style="padding-top:56px;">
    <form class="search-form reveal in" action="/search/" method="get" role="search">
      <input
        class="search-input"
        type="search"
        name="q"
        value={q}
        placeholder="搜索篇名、摘要与正文……"
        aria-label="站内搜索"
      />
      <button class="btn btn-primary" type="submit">寻</button>
    </form>
    <p class="section-lead reveal in" style="text-align:center;font-size:0.8rem;margin-top:10px;opacity:0.65;">
      以「#」开头的词检索标签：「#校园」览全标签，「#校园 庄桂清」在标签内寻章；其余照常寻章。
    </p>

    {
      q ? (
        tagMode && tagNotFound ? (
          <p class="section-lead reveal in" style="text-align:center;">
            标签「{tagNotFound}」尚未建立。<a href="/tags/">览全部标签 →</a>
          </p>
        ) : results.length > 0 ? (
          <div class="posts-grid" style="margin-top:32px;">
            {results.map(({ post, collection }, i) => (
              <a class="post-card reveal" data-delay={String((i % 3) + 1)} href={postHref(post.slug, collection?.slug)} style={`--cc: ${collection?.theme_color ?? '#c23a30'};`}>
                <h3 class="post-title">{post.title}</h3>
                {post.summary && <p class="post-summary">{post.summary}</p>}
                <div class="post-meta">
                  {collection && <span class="post-tag">{collection.title}</span>}
                  <span>{fmtDate(post.created_at)}</span>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <p class="section-lead reveal in" style="text-align:center;">未寻得「{q}」相关篇章。</p>
        )
      ) : (
        <p class="section-lead reveal in" style="text-align:center;">输入关键字，遍寻全卷。</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .search-form {
    display: flex;
    gap: 12px;
    max-width: 560px;
    margin: 0 auto;
  }
  .search-input {
    flex: 1;
    min-width: 0;
    padding: 12px 16px;
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--ink-deep);
    background: var(--paper-card);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .search-input:focus {
    border-color: var(--cinnabar);
    box-shadow: 0 0 0 3px var(--cinnabar-line);
  }
</style>