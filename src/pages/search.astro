---
// 月下独酌 · blog（blog_for_WhiteMoon319）
// Copyright (C) 2026 WhiteMoon319 · AGPL-3.0-or-later · 源码见 https://github.com/WhiteMoon319/blog_for_WhiteMoon319
import BaseLayout from '../layouts/BaseLayout.astro';
import { envOf, searchPublishedPosts, getCollectionsByIds, findTagIds, fmtDate } from '../lib/db';
import { postHref } from '../lib/utils';

export const prerender = false;

const env = await envOf();
let q = (Astro.url.searchParams.get('q') ?? '').trim();

// 「#标签1 #标签2 关键词」为标签检索：# 前缀词均为标签（多标签交集），其余 token 为标签内关键词。
// 例：#校园 → 校园；#校园 #恋爱 → 校园∩恋爱；#校园 庄桂清 → 校园内寻「庄桂清」。
// 无任何 # 标签词时按普通全文检索处理。
const tagNames: string[] = [];
const keywordTokens: string[] = [];
for (const token of q.split(/\s+/).filter(Boolean)) {
  if (token.startsWith('#')) {
    const name = token.slice(1).trim();
    if (name && !tagNames.includes(name)) tagNames.push(name);
  } else {
    keywordTokens.push(token);
  }
}
const tagKeyword = keywordTokens.join(' ').trim();
// 查询仅由孤立的「#」组成（如 "#"、"# #"）时没有可检索内容，清空 q 展示空态
if (tagNames.length === 0 && !tagKeyword && /#/.test(q)) {
  q = '';
}
let tagMode = false;
let tagNotFound = '';
if (tagNames.length > 0) {
  tagMode = true;
  // 校验全部标签：任何一个不存在都不转跳（findTagIds 只读，不产生副作用）
  let missing = '';
  for (const n of tagNames) {
    const ids = await findTagIds(env.DB, [n]);
    if (ids.length === 0) {
      missing = n;
      break;
    }
  }
  if (!missing) {
    const params = new URLSearchParams();
    tagNames.forEach((n) => params.append('t', n));
    if (tagKeyword) params.set('q', tagKeyword);
    return Astro.redirect(`/tags/?${params.toString()}`);
  }
  tagNotFound = missing;
}

const posts = q ? await searchPublishedPosts(env.DB, q) : [];
const collections = await getCollectionsByIds(env.DB, posts.map((p) => p.collection_id ?? 0));
const results: { post: (typeof posts)[number]; collection: { slug: string; title: string; theme_color: string } | null }[] = [];
for (const post of posts) {
  const collection = post.collection_id ? collections.get(post.collection_id) ?? null : null;
  results.push({ post, collection });
}
---

<BaseLayout title="寻章" description="站内搜索">
  <div class="page-hero">
    <a class="page-back reveal in" href="/">← 回到卷首</a>
    <div class="page-hero-card reveal in">
      <p class="character-kicker">寻</p>
      <h1>寻章摘句</h1>
      <p class="lead">于卷帙之间，觅得一言。</p>
    </div>
  </div>

  <section class="section" style="padding-top:56px;">
    <form class="search-form reveal in" action="/search/" method="get" role="search">
      <input
        class="search-input"
        type="search"
        name="q"
        value={q}
        placeholder="搜索篇名、摘要与正文……"
        aria-label="站内搜索"
      />
      <button class="btn btn-primary" type="submit">寻</button>
    </form>
    <p class="section-lead reveal in" style="text-align:center;font-size:0.8rem;margin-top:10px;opacity:0.65;">
      以「#」开头的词为标签：「#校园」览全标签，「#校园 #恋爱」多标签交集，「#校园 庄桂清」在标签内寻章；其余照常寻章。
    </p>

    {
      q ? (
        tagMode && tagNotFound ? (
          <p class="section-lead reveal in" style="text-align:center;">
            标签「{tagNotFound}」尚未建立。<a href="/tags/">览全部标签 →</a>
          </p>
        ) : results.length > 0 ? (
          <div class="posts-grid" style="margin-top:32px;">
            {results.map(({ post, collection }, i) => (
              <a class="post-card reveal" data-delay={String((i % 3) + 1)} href={postHref(post.slug, collection?.slug)} style={`--cc: ${collection?.theme_color ?? '#c23a30'};`}>
                <h3 class="post-title">{post.title}</h3>
                {post.summary && <p class="post-summary">{post.summary}</p>}
                <div class="post-meta">
                  {collection && <span class="post-tag">{collection.title}</span>}
                  <span>{fmtDate(post.created_at)}</span>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <p class="section-lead reveal in" style="text-align:center;">未寻得「{q}」相关篇章。</p>
        )
      ) : (
        <p class="section-lead reveal in" style="text-align:center;">输入关键字，遍寻全卷。</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .search-form {
    display: flex;
    gap: 12px;
    max-width: 560px;
    margin: 0 auto;
  }
  .search-input {
    flex: 1;
    min-width: 0;
    padding: 12px 16px;
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--ink-deep);
    background: var(--paper-card);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .search-input:focus {
    border-color: var(--cinnabar);
    box-shadow: 0 0 0 3px var(--cinnabar-line);
  }
</style>