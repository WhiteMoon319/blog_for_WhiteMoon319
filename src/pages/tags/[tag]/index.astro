import BaseLayout from '@theme/layouts/BaseLayout.astro';
import TagResults from '@theme/components/TagResults.astro';
import { envOf, getTagPage } from '../../../lib/db';

export const prerender = false;

const env = await envOf();
// Astro.params 已解码，勿再 decodeURIComponent（标签名含 % 会被双重解码炸 500）
const name = Astro.params.tag ?? '';
const keyword = (Astro.url.searchParams.get('q') ?? '').trim();
const page = await getTagPage(env.DB, name, keyword);

if (!page) {
  return Astro.redirect('/404');
}
import { getSiteContext } from "../../../lib/theme-context";
const siteCtx = await getSiteContext(Astro);
import { getTagsUnion } from '../../../lib/db';
const union = await getTagsUnion(env.DB, [name], keyword);
---

<BaseLayout ctx={siteCtx} title={`标签「${name}」`} description={`标签「${name}」下的文集与文章。`}>
  <div class="page-hero">
    <a class="page-back reveal in" href="/tags/">← 回到标签</a>
    <div class="page-hero-card reveal in">
      <p class="character-kicker">标 引</p>
      <h1>「{name}」</h1>
      <p class="lead">
        {page.collections.length} 部文集 · {page.posts.length} 篇{keyword ? `（寻「${keyword}」）` : ''}
      </p>
    </div>
  </div>

  <section class="section" style="padding-top:56px;">
    <div style="margin-top:36px;">
      <TagResults names={[name]} keyword={keyword} collections={union.collections} posts={union.posts} collectionPosts={union.collectionPosts} />
    </div>
  </section>
</BaseLayout>
