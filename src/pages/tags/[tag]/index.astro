import TagDetailTemplate from '@theme/templates/tag-detail.astro';
import { envOf, getTagPage } from '../../../lib/db';

export const prerender = false;

const env = await envOf();
// Astro.params 已解码，勿再 decodeURIComponent（标签名含 % 会被双重解码炸 500）
const name = Astro.params.tag ?? '';
const keyword = (Astro.url.searchParams.get('q') ?? '').trim();
const page = await getTagPage(env.DB, name, keyword);

if (!page) {
  return Astro.redirect('/404');
}
import { getSiteContext } from "../../../lib/theme-context";
const siteCtx = await getSiteContext(Astro);
import { getTagsUnion } from '../../../lib/db';
import { badgesByPostId } from '../../../lib/authors-view';
const union = await getTagsUnion(env.DB, [name], keyword);
// 列表卡署名：标签详情结果一次性取回
const authorsByPost = await badgesByPostId(env.DB, union.posts.map((p) => p.id));
---

<TagDetailTemplate
  ctx={siteCtx}
  name={name}
  keyword={keyword}
  collectionsCount={page.collections.length}
  postsCount={page.posts.length}
  collections={union.collections}
  posts={union.posts}
  collectionPosts={union.collectionPosts}
  authorsByPost={authorsByPost}
/>
