import TagIndexTemplate from '@theme/templates/tag-index.astro';
import { envOf, listAllTagCounts, getTagsUnion } from '../../lib/db';

export const prerender = false;

const env = await envOf();
// searchParams.get 已解码，勿再 decodeURIComponent（标签名含 % 会被双重解码炸 500）
const selected = Astro.url.searchParams.getAll('t').filter(Boolean);
const keyword = Astro.url.searchParams.get('q') ?? '';
const tags = (await listAllTagCounts(env.DB)).filter((t) => t.total > 0);
import { getSiteContext } from "../../lib/theme-context";
const siteCtx = await getSiteContext(Astro);
const union = await getTagsUnion(env.DB, selected, keyword);
---

<TagIndexTemplate
  ctx={siteCtx}
  selected={selected}
  keyword={keyword}
  tags={tags}
  collections={union.collections}
  posts={union.posts}
  collectionPosts={union.collectionPosts}
/>
