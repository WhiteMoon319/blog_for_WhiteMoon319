import BaseLayout from '@theme/layouts/BaseLayout.astro';
const redirect = Astro.url.searchParams.get('redirect') ?? '/';
// 防开放重定向：仅允许站内路径
const safeRedirect = redirect.startsWith('/') && !redirect.startsWith('//') ? redirect : '/';
import { getSiteContext } from "../lib/theme-context";
const siteCtx = await getSiteContext(Astro);
---

<BaseLayout ctx={siteCtx} title="验证邮箱" noindex>
  <div class="auth-page">
    <div class="auth-card">
      <h1>验证邮箱</h1>
      <p class="sub">输入验证码完成邮箱验证，验证后可发表评论</p>
      <form id="code-form">
        <div class="auth-field">
          <label for="code">验证码</label>
          <input id="code" class="input" inputmode="numeric" maxlength="6" placeholder="6 位数字" required />
        </div>
        <button class="btn btn-primary" type="submit" style="width:100%;justify-content:center;">验证</button>
        <p id="verify-error" class="auth-error" style="display:none;"></p>
      </form>
      <button id="resend-btn" class="btn btn-ghost" type="button" style="width:100%;justify-content:center;margin-top:8px;">重新发送验证码</button>
      <p class="auth-alt"><a href="/login/">返回登录</a></p>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('code-form')! as HTMLFormElement;
  const errEl = document.getElementById('verify-error')!;
  const codeInput = document.getElementById('code') as HTMLInputElement;
  const resendBtn = document.getElementById('resend-btn')! as HTMLButtonElement;
  const redirect = new URLSearchParams(location.search).get('redirect') ?? '/';
  // 防开放重定向：仅允许站内路径
  const safeRedirect = redirect.startsWith('/') && !redirect.startsWith('//') ? redirect : '/';

  // 获取当前用户信息
  let userId: number | null = null;
  let email = '';

  fetch('/api/auth/me', { credentials: 'same-origin' }).then(async (r) => {
    if (r.status !== 200) { location.href = '/login/?redirect=' + encodeURIComponent(location.pathname); return; }
    const data = await r.json() as { email_verified?: boolean; sub?: string; email?: string };
    if (data.email_verified) { location.href = safeRedirect; return; }
    userId = data.sub ? parseInt(data.sub.replace('user:', '')) : null;
    email = data.email ?? '';
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (userId === null) return;
    errEl.style.display = 'none';
    const code = codeInput.value.trim();
    if (!code) return;
    const res = await fetch('/api/auth/verify-email', {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ user_id: userId, code }),
    });
    if (!res.ok) {
      const data = await res.json() as { error?: string };
      errEl.textContent = data.error ?? '验证失败';
      errEl.style.display = 'block';
      return;
    }
    location.href = safeRedirect;
  });

  resendBtn.addEventListener('click', async () => {
    if (!email) return;
    resendBtn.disabled = true;
    const res = await fetch('/api/auth/resend-verification', {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email }),
    });
    setTimeout(() => { resendBtn.disabled = false; }, 60 * 1000);
  });
</script>