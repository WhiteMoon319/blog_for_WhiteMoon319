import type { SiteContext, AuthorBadge } from '../../../lib/theme-context.ts';
import { postHref, fmtDate } from '@core/utils';
import { classicT } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorByline from '@core/AuthorByline.astro';
import CardLink from '@core/CardLink.astro';
import Pagination from '../components/Pagination.astro';

interface CollectionRow {
  id: number;
  slug: string;
  title: string;
  summary: string;
  theme_color: string;
  sort_order: number;
  post_order: 'asc' | 'desc';
}
interface PostRow {
  id: number;
  collection_id: number | null;
  slug: string;
  title: string;
  summary: string;
  cover_url: string;
  created_at: string;
}

interface Props {
  ctx: SiteContext;
  /** JSON-LD 序列化产物（页面壳经 safeJsonLd 生成） */
  jsonLd: string;
  collection: CollectionRow;
  posts: PostRow[];
  total: number;
  page: number;
  totalPages: number;
  /** 集主（文集署名）；无归属不渲染 */
  owner?: AuthorBadge | null;
  /** 文章署名，按文章 id 索引（一次批量取回） */
  authorsByPost?: Record<string, AuthorBadge[]>;
}

const { ctx, jsonLd, collection, posts, total, page, totalPages, owner = null, authorsByPost = {} } = Astro.props;
const t = classicT(ctx.locale);
---

<BaseLayout ctx={ctx} title={collection.title} description={collection.summary}>
  <script type="application/ld+json" set:html={jsonLd} />
  <div class="page-hero" style={`--cc: ${collection.theme_color};`}>
    <a class="page-back reveal in" href="/">← 回到卷首</a>

    <div class="page-hero-card reveal in">
      <p class="character-kicker">文 集</p>
      <h1>{collection.title}</h1>
      {collection.summary && <p class="lead">{collection.summary}</p>}
      <div class="facts">
        <span>{total} 篇</span>
        <span>序 {collection.sort_order}</span>
        {owner && <AuthorByline authors={[owner]} prefix={t('collection.byline')} variant="collection" />}
      </div>
    </div>
  </div>

  <section class="section" style="padding-top:56px;">
    {
      posts.length > 0 ? (
        <div class="posts-grid">
          {posts.map((p, i) => (
            <div class="post-card reveal" data-delay={String((i % 3) + 1)} style={`--cc: ${collection.theme_color};`}>
              {p.cover_url && <img class="post-cover" src={p.cover_url} alt="" loading="lazy" decoding="async" />}
              <h3 class="post-title"><CardLink href={postHref(p.slug, collection.slug)}>{p.title}</CardLink></h3>
              {p.summary && <p class="post-summary">{p.summary}</p>}
              <div class="post-meta">
                <span class="post-tag">{collection.title}</span>
                <AuthorByline authors={authorsByPost[String(p.id)] ?? []} variant="card" />
                <span>{fmtDate(p.created_at)}</span>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="section-lead reveal in" style="text-align:center;">此集尚空，静候主人落笔。</p>
      )
    }
    <Pagination current={page} totalPages={totalPages} base={`/collections/${collection.slug}/`} query="" />
  </section>
</BaseLayout>
