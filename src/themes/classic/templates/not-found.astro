import type { SiteContext } from '../../../lib/theme-context.ts';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  ctx: SiteContext;
}

const { ctx } = Astro.props;
---

<BaseLayout ctx={ctx} title="失路" description="此页不在卷中">
  <div class="page-hero">
    <a class="page-back reveal in" href="/">← 回到卷首</a>
    <div class="page-hero-card reveal in">
      <p class="character-kicker">佚</p>
      <h1>此页不存</h1>
      <p class="lead">所寻之篇，或已焚毁，或从未落笔。</p>
    </div>
  </div>

  <section class="section" style="padding-top:56px;">
    <div class="colophon reveal">
      <div class="seal lg">佚</div>
      <p>404 · 失路于卷帙之间</p>
      <p style="margin-top:24px;">
        <a class="btn btn-primary" href="/">回到卷首</a>
        <a class="btn btn-ghost" href="/archive/" style="margin-left:8px;">展开归档</a>
        <a class="btn btn-ghost" href="/search/" style="margin-left:8px;">寻章摘句</a>
      </p>
    </div>
  </section>
</BaseLayout>
