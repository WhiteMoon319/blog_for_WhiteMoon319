---
// 月下独酌 · blog（blog_for_WhiteMoon319）
// Copyright (C) 2026 WhiteMoon319 · AGPL-3.0-or-later · 源码见 https://github.com/WhiteMoon319/blog_for_WhiteMoon319
// 文章详情模板：整合三处来源（独立文章 / 文集内文章 / 草稿预览）的展示标记。
// 纯展示组件，一切数据经 props 下传，禁止自行访问 DB/env。
import type { SiteContext } from '../../../lib/theme-context.ts';
import { postHref, fmtDate } from '@core/utils';
import { classicT } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostLike from '../components/PostLike.astro';
import Comments from '../components/Comments.astro';
import ArticleEnhancer from '../components/ArticleEnhancer.astro';

interface TocItem {
  id: string;
  text: string;
  level: number;
}

interface AdjacentLink {
  slug: string;
  title: string;
  collection_slug?: string | null;
}

interface Props {
  ctx: SiteContext;
  /** 文章 id（点赞/评论组件定位用） */
  postId: number;
  title: string;
  summary?: string | null;
  coverUrl?: string | null;
  /** SEO 关键词（仅独立文章详情页传入） */
  keywords?: string | null;
  createdAt: string;
  updatedAt: string;
  viewCount: number;
  /** 服务端渲染后的正文 HTML */
  html: string;
  toc: TocItem[];
  tags?: { name: string }[];
  /** 上一篇/下一篇（预览源不传） */
  prev?: AdjacentLink | null;
  next?: AdjacentLink | null;

  // —— 三源渲染差异，由页面壳计算后传入 ——
  /** 页首 hero 色条 --cc（独立文 #c23a30 / 文集 theme_color / 预览回退 #8a6d3b） */
  accentColor: string;
  /** 返回链接地址与完整文案（含「← 」前缀，逐字保持原文案） */
  backHref: string;
  backLabel: string;
  /** kicker 前缀文案（文集标题或「未分类」） */
  kicker: string;

  // —— head/meta 差异 ——
  /** og:image（文集内文章与预览传封面；独立文章页原样未传） */
  ogImage?: string | null;
  noindex?: boolean;
  /** 页面壳生成的 JSON-LD 安全字符串（仅独立文章详情页注入 BlogPosting） */
  jsonLd?: string | null;

  // —— 交互区差异 ——
  /** 点赞数；不传则不渲染点赞组件（预览源无） */
  likes?: number;
  liked?: boolean;
  /** 是否渲染评论区（默认 true，预览源为 false） */
  showComments?: boolean;

  // —— 预览态 ——
  /** 草稿预览：渲染顶部「草稿预览 · 仅你可见」横幅 */
  isPreview?: boolean;
  /** 草稿预览横幅第二行文案（「（未刊发）/（已刊发）」，由页面壳按 status 计算） */
  previewBadgeText?: string;
  /** 「查看正式页面 →」链接目标（仅预览态且已刊发且属文集时由页面壳传入） */
  publishedHref?: string | null;

  // —— 阅读历史 ——
  /** 登录用户的上次阅读位置（0-100）；未登录/无记录不传 */
  initialScrollPct?: number;
}

const {
  ctx,
  postId,
  title,
  summary = '',
  coverUrl = '',
  keywords,
  createdAt,
  updatedAt,
  viewCount,
  html,
  toc,
  tags = [],
  prev,
  next,
  accentColor,
  backHref,
  backLabel,
  kicker,
  ogImage,
  noindex = false,
  jsonLd,
  likes,
  liked = false,
  showComments = true,
  isPreview = false,
  previewBadgeText = '',
  publishedHref,
  initialScrollPct,
} = Astro.props;
const t = classicT(ctx.locale);
---

<BaseLayout ctx={ctx} title={title} description={summary ?? undefined} keywords={keywords ?? undefined} image={ogImage ?? undefined} noindex={noindex}>
  {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

  {isPreview && (
    <div class="preview-banner">
      草稿预览 · 仅你可见
      {previewBadgeText}
    </div>
  )}

  <div class="page-hero" style={`--cc: ${accentColor};`}>
    <a class="page-back reveal in" href={backHref}>{backLabel}</a>

    <div class="page-hero-card reveal in">
      <p class="character-kicker">{kicker} · {fmtDate(createdAt)}</p>
      <h1>{title}</h1>
      {summary && <p class="lead">{summary}</p>}
      <div class="facts">
        <span>成于 {fmtDate(createdAt)}</span>
        {updatedAt !== createdAt && <span>改于 {fmtDate(updatedAt)}</span>}
        <span data-views={viewCount}>阅 {viewCount}</span>
      </div>
      {tags.length > 0 && (
        <div class="facts tag-row">
          {tags.map((t) => (
            <a class="tag-chip" href={`/tags/${encodeURIComponent(t.name)}/`}>{t.name}</a>
          ))}
        </div>
      )}
    </div>
  </div>

  <article class="article">
    <div class="article-toolbar" role="group" aria-label={t('post.font_scale')}>
      <span class="article-toolbar-label">{t('post.font_scale')}</span>
      <button type="button" class="btn btn-ghost mini font-scale-btn" data-fs="-1" aria-label={t('post.font_smaller')}>A−</button>
      <button type="button" class="btn btn-ghost mini font-scale-btn" data-fs="0" aria-label={t('post.font_default')}>A</button>
      <button type="button" class="btn btn-ghost mini font-scale-btn" data-fs="1" aria-label={t('post.font_larger')}>A+</button>
    </div>
    <div class="reading-progress-pill" id="readingProgressPill" role="progressbar" aria-label={t('post.read_progress')} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-prefix={t('post.read_progress')}>0%</div>
    {coverUrl && <img class="article-cover" src={coverUrl} alt="" loading="eager" decoding="async" />}
    <div class="article-body reveal in" set:html={html} />

    {toc.length > 1 && (
      <nav class="article-toc" aria-label="目录">
        <p class="toc-title">目 录</p>
        <ol>
          {toc.map((t) => (
            <li class={`toc-lv${t.level}`}>
              <a href={`#${t.id}`}>{t.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <nav class="article-pagination">
      {prev && <a class="btn btn-ghost" href={postHref(prev.slug, prev.collection_slug)}>← {prev.title}</a>}
      {next && <a class="btn btn-ghost" href={postHref(next.slug, next.collection_slug)}>{next.title} →</a>}
      {publishedHref && <a class="btn btn-ghost" href={publishedHref}>查看正式页面 →</a>}
    </nav>
  </article>
  {typeof likes === 'number' && <PostLike postId={postId} likes={likes} liked={liked} />}
  {showComments && <Comments postId={postId} r2Base={ctx.r2Base} />}
  <ArticleEnhancer html={html} />
</BaseLayout>

<style>
  .preview-banner {
    position: sticky;
    top: 0;
    z-index: 40;
    text-align: center;
    padding: 8px 16px;
    background: var(--cinnabar);
    color: var(--paper-warm);
    font-family: var(--font-serif);
    font-size: 0.85rem;
    letter-spacing: 0.12em;
  }

  .article-toolbar {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    margin-bottom: 24px;
    padding: 4px 6px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    background: var(--paper-card);
  }
  .article-toolbar-label {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--ink-light);
    margin-right: 4px;
    margin-left: 6px;
  }
  .article-toolbar .font-scale-btn {
    min-width: 34px;
    padding: 2px 8px;
    font-family: var(--font-serif);
    font-size: 0.9rem;
    border-radius: var(--radius-pill);
  }
  .article-toolbar .font-scale-btn.is-active {
    background: var(--cinnabar);
    border-color: var(--cinnabar);
    color: var(--paper-warm);
  }

  .reading-progress-pill {
    position: fixed;
    left: 28px;
    bottom: 28px;
    z-index: 30;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--ink-mid);
    background: var(--paper-card);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-card);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }
  .reading-progress-pill.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .reading-progress-pill::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--cinnabar);
  }
  @media (max-width: 599px) {
    .reading-progress-pill {
      left: 28px;
      bottom: 28px;
      padding: 5px 12px;
    }
  }
</style>

<script define:vars={{ initialPct: initialScrollPct, loggedIn: ctx.user.loggedIn, postIdNum: postId }}>
  // 阅读历史：进入恢复上次位置；离开静默上报当前位置（登录用户）
  const hasArticle = !!document.querySelector('.article-body');
  let readingPosted = false;
  const progressPill = document.getElementById('readingProgressPill');

  function calcScrollPct() {
    const doc = document.documentElement;
    const max = doc.scrollHeight - window.innerHeight;
    if (max <= 0) return 0;
    return Math.round((window.scrollY / max) * 100);
  }

  function updateProgressPill() {
    if (!progressPill) return;
    const pct = calcScrollPct();
    progressPill.textContent = `${progressPill.dataset.prefix ?? ''}${pct}%`;
    progressPill.setAttribute('aria-valuenow', String(pct));
    if (pct >= 2 && hasArticle) progressPill.classList.add('is-visible');
    else progressPill.classList.remove('is-visible');
  }

  function restoreScroll() {
    if (typeof initialPct !== 'number' || !(initialPct > 0 && initialPct <= 100)) return;
    const target = () => {
      const doc = document.documentElement;
      const max = doc.scrollHeight - window.innerHeight;
      if (max > 0) window.scrollTo(0, (max * initialPct) / 100);
      updateProgressPill();
    };
    // 等待正文/图表渲染完成后再恢复，避免高度未定导致位置偏移
    window.addEventListener('load', () => setTimeout(target, 120));
    setTimeout(target, 800);
  }

  function reportReading() {
    if (readingPosted || !loggedIn || !hasArticle || !postIdNum) return;
    const pct = calcScrollPct();
    // 仅在确实滚动阅读过时上报（避免仅打开页面即产生历史）
    if (pct <= 1) return;
    readingPosted = true;
    fetch('/api/reading', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      keepalive: true,
      body: JSON.stringify({ postId: postIdNum, scrollPct: pct }),
    }).catch(() => {
      /* 静默失败：不影响阅读 */
    });
  }

  // 离开页面（切后台/关闭/跳转）时静默记录
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') reportReading();
  });
  window.addEventListener('pagehide', reportReading);
  window.addEventListener('scroll', () => updateProgressPill(), { passive: true });
  window.addEventListener('load', updateProgressPill);

  restoreScroll();
</script>

<script>
  // 阅读字号：A− / A / A+（作用于 .article-body 的 --font-scale，仅正文缩放）
  const BODY_SEL = '.article-body';
  const STORAGE_KEY = 'classic-font-scale-level';
  // 档位 → 缩放系数
  const SCALES: Record<number, number> = { '-1': 0.9, 0: 1, 1: 1.15 };
  const DEFAULT_LEVEL = 0;

  const body = document.querySelector<HTMLDivElement>(BODY_SEL);
  if (!body) throw new Error('.article-body 不存在');
  const articleBody = body as HTMLDivElement;

  let level: number = DEFAULT_LEVEL;
  try {
    const saved = Number(localStorage.getItem(STORAGE_KEY));
    if (saved in SCALES) level = saved;
  } catch {
    /* localStorage 不可用则保持默认档 */
  }

  function applyScale() {
    articleBody.style.setProperty('--font-scale', String(SCALES[level]));
    document.querySelectorAll<HTMLButtonElement>('.font-scale-btn').forEach((btn) => {
      btn.classList.toggle('is-active', Number(btn.dataset.fs) === level);
    });
  }

  function setScale(next: number) {
    if (!(next in SCALES)) return;
    level = next;
    try {
      localStorage.setItem(STORAGE_KEY, String(level));
    } catch {
      /* 忽略存储失败 */
    }
    applyScale();
  }

  document.querySelectorAll<HTMLButtonElement>('.font-scale-btn').forEach((btn) => {
    btn.addEventListener('click', () => setScale(Number(btn.dataset.fs)));
  });
  applyScale();
</script>
