---
// 月下独酌 · blog（blog_for_WhiteMoon319）
// Copyright (C) 2026 WhiteMoon319 · AGPL-3.0-or-later · 源码见 https://github.com/WhiteMoon319/blog_for_WhiteMoon319
// 文章详情模板（Modern）：整合三处来源（独立文章 / 文集内文章 / 草稿预览）的展示标记。
// 纯展示组件，一切数据经 props 下传，禁止自行访问 DB/env。
import type { SiteContext } from '../../../lib/theme-context.ts';
import { postHref, fmtDate } from '@core/utils';
import BaseLayout from '../layouts/BaseLayout.astro';
import { modernT } from '../i18n';
// 点赞/评论/文章增强组件本主题不自带，经 @theme 解析器回退 classic（样式变量由 tokens 换肤）
import PostLike from '@theme/components/PostLike.astro';
import Comments from '@theme/components/Comments.astro';
import ArticleEnhancer from '@theme/components/ArticleEnhancer.astro';

interface TocItem {
  id: string;
  text: string;
  level: number;
}

interface AdjacentLink {
  slug: string;
  title: string;
  collection_slug?: string | null;
}

interface Props {
  ctx: SiteContext;
  /** 文章 id（点赞/评论组件定位用） */
  postId: number;
  title: string;
  summary?: string | null;
  coverUrl?: string | null;
  /** SEO 关键词（仅独立文章详情页传入） */
  keywords?: string | null;
  createdAt: string;
  updatedAt: string;
  viewCount: number;
  /** 服务端渲染后的正文 HTML */
  html: string;
  toc: TocItem[];
  tags?: { name: string }[];
  /** 上一篇/下一篇（预览源不传） */
  prev?: AdjacentLink | null;
  next?: AdjacentLink | null;

  // —— 三源渲染差异，由页面壳计算后传入 ——
  /** 页首 hero 色条 --cc */
  accentColor: string;
  /** 返回链接地址与完整文案（含「← 」前缀，逐字保持页面壳文案） */
  backHref: string;
  backLabel: string;
  /** kicker 前缀文案（文集标题或「未分类」） */
  kicker: string;

  // —— head/meta 差异 ——
  ogImage?: string | null;
  noindex?: boolean;
  /** 页面壳生成的 JSON-LD 安全字符串 */
  jsonLd?: string | null;

  // —— 交互区差异 ——
  likes?: number;
  liked?: boolean;
  showComments?: boolean;

  // —— 预览态 ——
  isPreview?: boolean;
  previewBadgeText?: string;
  publishedHref?: string | null;

  // —— 阅读历史（核心壳传入；本主题暂不实现恢复/上报，接受即可） ——
  initialScrollPct?: number;
}

const {
  ctx,
  postId,
  title,
  summary = '',
  coverUrl = '',
  keywords,
  createdAt,
  updatedAt,
  viewCount,
  html,
  toc,
  tags = [],
  prev,
  next,
  accentColor,
  backHref,
  backLabel,
  kicker,
  ogImage,
  noindex = false,
  jsonLd,
  likes,
  liked = false,
  showComments = true,
  isPreview = false,
  previewBadgeText = '',
  publishedHref,
} = Astro.props;
const t = modernT(ctx.locale);
---

<BaseLayout ctx={ctx} title={title} description={summary ?? undefined} keywords={keywords ?? undefined} image={ogImage ?? undefined} noindex={noindex}>
  {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

  {isPreview && (
    <div class="preview-banner">
      {t('post.preview_banner')}
      {previewBadgeText}
    </div>
  )}

  <div class="page-hero" style={`--cc: ${accentColor};`}>
    <a class="page-back reveal in" href={backHref}>{backLabel}</a>

    <div class="page-hero-card reveal in">
      <p class="character-kicker">{kicker} · {fmtDate(createdAt)}</p>
      <h1>{title}</h1>
      {summary && <p class="lead">{summary}</p>}
      <div class="facts">
        <span>{t('post.created')} {fmtDate(createdAt)}</span>
        {updatedAt !== createdAt && <span>{t('post.updated')} {fmtDate(updatedAt)}</span>}
        <span data-views={viewCount}>{t('post.views', { count: viewCount })}</span>
      </div>
      {tags.length > 0 && (
        <div class="facts tag-row">
          {tags.map((tag) => (
            <a class="tag-chip" href={`/tags/${encodeURIComponent(tag.name)}/`}>{tag.name}</a>
          ))}
        </div>
      )}
    </div>
  </div>

  <article class="article">
    {coverUrl && <img class="article-cover" src={coverUrl} alt="" loading="eager" decoding="async" />}
    <div class="article-body reveal in" set:html={html} />

    {toc.length > 1 && (
      <nav class="article-toc" aria-label={t('post.toc')}>
        <p class="toc-title">{t('post.toc')}</p>
        <ol>
          {toc.map((item) => (
            <li class={`toc-lv${item.level}`}>
              <a href={`#${item.id}`}>{item.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <nav class="article-pagination">
      {prev && <a class="btn btn-ghost" href={postHref(prev.slug, prev.collection_slug)}>← {prev.title}</a>}
      {next && <a class="btn btn-ghost" href={postHref(next.slug, next.collection_slug)}>{next.title} →</a>}
      {publishedHref && <a class="btn btn-ghost" href={publishedHref}>{t('post.view_published')}</a>}
    </nav>
  </article>
  {typeof likes === 'number' && <PostLike postId={postId} likes={likes} liked={liked} />}
  {showComments && <Comments postId={postId} r2Base={ctx.r2Base} />}
  <ArticleEnhancer html={html} />
</BaseLayout>

<style>
  .preview-banner {
    position: sticky;
    top: 0;
    z-index: 40;
    text-align: center;
    padding: 8px 16px;
    background: var(--cinnabar);
    color: #fff;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
  }
</style>
