{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*"],
  "exclude": ["dist", "admin", "node_modules"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "paths": {
      "@core/*": ["./src/core/*"],
      "@theme/*": ["./src/themes/classic/*"]
    }
  }
}