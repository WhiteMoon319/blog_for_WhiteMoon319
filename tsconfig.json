{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "admin",
    "node_modules",
    "src/themes/modern",
    "src/themes/starter",
    "src/themes/wildfire"
  ],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "paths": {
      "@core/*": [
        "./src/core/*"
      ],
      "@theme/*": [
        "./src/themes/classic/*",
        "./src/themes/classic/*"
      ]
    }
  }
}
