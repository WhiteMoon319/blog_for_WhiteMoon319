{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog-db",
      "database_id": "77b3c654-3293-49b1-8aa7-a327de1f3af6",
      "migrations_dir": "./db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "blog-images"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "da2e3f08c7534b67b53ebc2fda0be30e"
    },
    {
      "binding": "RATE_LIMIT",
      "id": "17f1ee7a8dbe4ad8a02caf465a27c0d6"
    }
  ],
  "vars": {
    "SITE_NAME": "博客名",
    "SITE_SLOGAN": "某人的一角书斋",
    "SITE_POEM": "晨起摊书卷，夜来码字忙。",
    "LOGIN_RATE_LIMIT_MAX": 10,
    "LOGIN_RATE_LIMIT_WINDOW": 300
  }
}