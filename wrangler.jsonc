{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog-db",
      // ⚠️ 占位 ID：尚未取得真实资源。上线前必须执行 `wrangler login`，
      // 然后 `wrangler d1 create blog-db` 创建数据库并用返回的真实 ID 替换此处。
      // 未替换前禁止宣称远程部署完成。
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "blog-images"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      // 预留：会话续期/失效名单（当前会话为无状态 HMAC，暂未使用）
      "id": "00000000-0000-0000-0000-000000000000"
    },
    {
      "binding": "RATE_LIMIT",
      // ⚠️ 占位 ID：登录限流计数器。上线前执行 `wrangler kv namespace create RATE_LIMIT`
      // 并用返回的真实 ID 替换此处，未替换前禁止宣称远程部署完成。
      "id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "SITE_NAME": "博客名",
    "SITE_SLOGAN": "某人的一角书斋",
    "SITE_POEM": "晨起摊书卷，夜来码字忙。",
    "LOGIN_RATE_LIMIT_MAX": 10,
    "LOGIN_RATE_LIMIT_WINDOW": 300
  }
}